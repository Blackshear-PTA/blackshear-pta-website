# dev.config - per-app values for the dev controller (dev-control.sh sources this)
#
# Mirrors the IMPRES fleet convention (shared-references/bootstrap/dev.config.template)
# so this repo behaves like the other apps, but the service list is different:
# this is a static site, so there is no backend, no database and no Prisma.
#
# Shell-sourced: KEY=value, no spaces around `=`, quote strings.

APP_NAME="Blackshear PTA Website"
APP_ABBR="BPW"
APP_SHORT="blackshear-web"        # tmux tab name inside the shared dev window

# The three ways to run this site locally. Only DEV has hot reload; the other
# two build first and serve the real output, which is why they are separate.
DEV_PORT=4321                     # astro dev - hot reload, what you want 95% of the time
PREVIEW_PORT=4322                 # astro preview - the built static output
WORKER_PORT=8787                  # wrangler dev - the real Workers runtime

# Node is pinned in .node-version (Astro 7 needs >=22.12). tmux runs commands
# without an interactive shell, so fnm's use-on-cd hook never fires and a bare
# `npm run dev` would get the default Node 20 and fail. `fnm exec` reads
# .node-version on its own, which is why every launch goes through it.
NODE_RUNNER="fnm exec --"
