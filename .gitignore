node_modules/
dist/
.astro/
.wrangler/
# Generated from wrangler.jsonc by `wrangler types`; 15k lines of vendored
# runtime types that would dominate every diff. `npm run check` regenerates it.
worker-configuration.d.ts
.dev.vars
.env
.env.*
.DS_Store

# Terraform, if docs/TERRAFORM.md is ever acted on. State can contain secrets
# in plaintext and this repo is public; tfvars would hold the API token.
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
.terraform/
# .terraform.lock.hcl is deliberately NOT listed here. It pins provider
# versions and belongs in version control.
#
# terraform/ is a generated RECORD of the Cloudflare account, never applied.
# Keeping versions.tf out of the repo means `terraform init` fails there, which
# is what stops an `apply` creating a second copy of every resource. Copy
# versions.tf.example locally when regenerating. See terraform/README.md.
terraform/versions.tf
