{
  // Blackshear PTA - Cloudflare Workers with static assets (PROJECT-BRIEF §3.2).
  //
  // Deliberately NOT Cloudflare Pages: Durable Objects, Workflows, and Secrets
  // Store are Workers-only, and Phase 3 depends on Durable Objects. Starting on
  // Pages would mean a later migration with a domain switchover and downtime.
  //
  // There is intentionally no "main" field. The whole site is prerendered, so
  // this Worker serves static assets only and never invokes JS, which also
  // means it does not consume Workers request quota for asset hits.
  //
  // When SSR arrives (/api/*, /admin), add @astrojs/cloudflare, point "main" at
  // the adapter's generated entry, and set assets.binding so the Worker can
  // fall through to static files.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blackshear-pta",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./dist",
    // Serve Astro's built 404 page for unmatched paths.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
