---
import SiteHeader from '../../components/sections/SiteHeader.astro';
import Hero from '../../components/sections/Hero.astro';
import QuickActions from '../../components/sections/QuickActions.astro';
import News from '../../components/sections/News.astro';
import GetInvolved from '../../components/sections/GetInvolved.astro';
import Committees from '../../components/sections/Committees.astro';
import Footer from '../../components/sections/Footer.astro';
import type { HomeData, SiteData } from '../../types';

interface Props {
  home: HomeData;
  site: SiteData;
  /**
   * id for the <main> landmark. /preview renders both structures on one page,
   * and duplicate ids are invalid HTML and confuse assistive tech, so each
   * panel passes its own. Defaults to "main" for real pages.
   */
  mainId?: string;
}
const { home, site, mainId = 'main' } = Astro.props;
---

{/*
  STRUCTURE: stacked-rules  →  Civic Letterpress

  A broadsheet. One column, everything in reading order, heavy rules doing all
  the dividing. The arrangement is deliberately plain because the theme's whole
  argument is that weight and rule thickness carry a page without decoration.
*/}

<SiteHeader site={site} />
<div class="shell">
  <main id={mainId}>
    <Hero hero={home.hero} />
    <QuickActions quickActions={home.quickActions} />
    <div class="rule" role="presentation"></div>
    <News news={home.news} />
    <div class="rule" role="presentation"></div>
    <GetInvolved getInvolved={home.getInvolved} />
    <Committees committees={home.committees} />
  </main>
  <Footer footer={home.footer} social={site.social} />
</div>

<style>
  .shell {
    max-width: var(--pta-container);
    margin-inline: auto;
    padding-inline: var(--pta-gutter);
  }
  .rule {
    height: var(--pta-rule-width);
    background: var(--pta-rule);
  }
</style>
