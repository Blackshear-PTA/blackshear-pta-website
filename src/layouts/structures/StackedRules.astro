---
/**
 * The top band photo, ALREADY SIZED, imported rather than transformed.
 *
 * This was `getImage({ width: 1200, quality: 45, format: 'webp' })` on the
 * 3000x2000, 6.3MB original. That works at build time, and both pages using
 * this structure now render ON DEMAND - where the Cloudflare adapter has no
 * image service and its passthrough endpoint streams the SOURCE FILE back
 * unchanged. Measured: the homepage backdrop went from 180KB to 6,301,582
 * bytes, on the page a parent opens on a phone in the pickup line.
 *
 * A plain ESM import of an already-correct file has no such failure mode -
 * Astro emits it to _astro/ with a hash and hands back the URL, identically
 * whether the page was prerendered or rendered a second ago.
 *
 * campus-front-walk-band.webp is DERIVED from campus-front-walk.jpg and is
 * byte-for-byte what the old call produced. To regenerate it, see
 * src/assets/photos/README.md.
 */
import backdrop from '../../assets/photos/campus-front-walk-band.webp';
import SiteHeader from '../../components/sections/SiteHeader.astro';
import VideoEmbed from '../../components/sections/VideoEmbed.astro';
import Hero from '../../components/sections/Hero.astro';
import QuickActions from '../../components/sections/QuickActions.astro';
import Announcements from '../../components/sections/Announcements.astro';
import GetInvolved from '../../components/sections/GetInvolved.astro';
import Committees from '../../components/sections/Committees.astro';
import Footer from '../../components/sections/Footer.astro';
import type { HomeData, SiteData } from '../../types';
import type { Post } from '../../lib/announcements';

interface Props {
  home: HomeData;
  site: SiteData;
  /** Announcements to show, already filtered and ordered. Fetched by the page:
   *  this structure is rendered by both / and /preview, and only one of them
   *  should decide where the data comes from. */
  posts: Post[];
  /** Every published post, for the "see all N" link. */
  total: number;
  /**
   * id for the <main> landmark. /preview renders both structures on one page,
   * and duplicate ids are invalid HTML and confuse assistive tech, so each
   * panel passes its own. Defaults to "main" for real pages.
   */
  mainId?: string;
  /**
   * Show the homepage video. Comes from the theme, not the content: the video
   * exists in home.yaml either way and this decides whether this design shows
   * it. Currently only Civic Letterpress B opts in, so the board can compare
   * it against A with nothing else changed.
   */
  video?: boolean;
}
const { home, site, posts, total, mainId = 'main', video = false } = Astro.props;

// Same asset as the editorial structure, deliberately: one import both themes
// share rather than two near-identical encodes.
//
// Quality is low on purpose. The photo sits under an ~80% scrim, so detail is
// invisible by construction and a full-quality encode would be most of the page
// weight for nothing. The URL goes in as an inline custom property below
// because a scoped <style> block cannot reach an import.
---

{/*
  STRUCTURE: stacked-rules  →  Civic Letterpress

  A broadsheet. One column, everything in reading order, heavy rules doing all
  the dividing. The arrangement is deliberately plain because the theme's whole
  argument is that weight and rule thickness carry a page without decoration.

  The top band is the one exception: hero and Start Here sit over a full-bleed
  photograph of the school.
*/}

<SiteHeader site={site} />
<main id={mainId}>
  <div class="topband" style={`--topband-img: url(${backdrop.src})`}>
    <div class="shell">
      <Hero hero={home.hero} headlineId={`hero-${mainId}`}>
        {video && home.video && <VideoEmbed video={home.video} />}
      </Hero>
      <QuickActions quickActions={home.quickActions} />
    </div>
  </div>

  <div class="shell">
    <div class="rule" role="presentation"></div>
    <Announcements announcements={home.announcements} posts={posts} total={total} />
    <div class="rule" role="presentation"></div>
    <GetInvolved getInvolved={home.getInvolved} />
    <Committees committees={home.committees} />
  </div>
</main>
<div class="shell">
  <Footer footer={home.footer} social={site.social} />
</div>

<style>
  .shell {
    max-width: var(--pta-container);
    margin-inline: auto;
    padding-inline: var(--pta-gutter);
  }
  .rule {
    height: var(--pta-rule-width);
    background: var(--pta-rule);
  }

  /*
    Full-bleed photographic band. It is a sibling of the shells rather than a
    wrapper inside one, so the photo reaches both screen edges without the
    `calc(50% - 50vw)` trick, which is off by the scrollbar width and put this
    page into horizontal scroll the last time it was used here.

    The scrim is a pseudo-element rather than a translucent background on the
    band itself, so the alpha stays one tunable number and the content above it
    is fully opaque.
  */
  .topband {
    position: relative;
    isolation: isolate;
    background-image: var(--topband-img);
    background-size: cover;
    background-position: center 30%;
    /* Not `fixed`: iOS Safari renders that at the wrong scale and stutters. */
    background-attachment: scroll;
    padding-block-end: var(--pta-gap);
  }

  .topband::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--pta-topband-scrim);
    opacity: var(--pta-topband-alpha);
  }
</style>
