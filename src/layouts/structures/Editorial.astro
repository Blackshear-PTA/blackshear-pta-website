---
import SiteHeader from '../../components/sections/SiteHeader.astro';
import Hero from '../../components/sections/Hero.astro';
import QuickActions from '../../components/sections/QuickActions.astro';
import News from '../../components/sections/News.astro';
import GetInvolved from '../../components/sections/GetInvolved.astro';
import Committees from '../../components/sections/Committees.astro';
import Footer from '../../components/sections/Footer.astro';
import type { HomeData, SiteData } from '../../types';

interface Props {
  home: HomeData;
  site: SiteData;
  /**
   * id for the <main> landmark. /preview renders both structures on one page,
   * and duplicate ids are invalid HTML and confuse assistive tech, so each
   * panel passes its own. Defaults to "main" for real pages.
   */
  mainId?: string;
}
const { home, site, mainId = 'main' } = Astro.props;
---

{/*
  STRUCTURE: editorial  →  East Austin Print Shop

  An asymmetric magazine grid. The hero runs wide, then the page splits: news
  takes the broad column, quick actions sit in a narrow rail beside it. The
  imbalance is the point - an even three-up grid is the generic-AI tell the
  brief calls out (§5.1), and a real editorial page is never symmetrical.

  Collapses to one column below 60rem, rail first, because on a phone the
  "what do I do" links matter more than the reading.
*/}

<SiteHeader site={site} />
<main id={mainId}>
  <div class="shell">
    <div class="lede">
      <Hero hero={home.hero} />
    </div>

    <div class="split">
      <div class="wide"><News news={home.news} /></div>
      <aside class="rail"><QuickActions quickActions={home.quickActions} /></aside>
    </div>
  </div>

  {/*
    The tinted band is a SIBLING of the containers, not a child. The usual
    `margin-inline: calc(50% - 50vw)` full-bleed trick is off by the scrollbar
    width - 50vw counts it, 50% does not, which pushes the page into
    horizontal scroll on any desktop with a classic scrollbar. Letting the band
    be full width naturally avoids the arithmetic entirely.
  */}
  <div class="band" data-surface="alt">
    <div class="shell"><GetInvolved getInvolved={home.getInvolved} /></div>
  </div>

  <div class="shell">
    <Committees committees={home.committees} />
  </div>
</main>
<div class="shell">
  <Footer footer={home.footer} social={site.social} />
</div>

<style>
  .shell {
    max-width: var(--pta-container);
    margin-inline: auto;
    padding-inline: var(--pta-gutter);
  }
  .lede {
    max-width: 52rem;
  }
  .split {
    display: grid;
    gap: 0 calc(var(--pta-gap) * 2.5);
  }
  .rail {
    border-block-start: var(--pta-rule-width) solid var(--pta-rule);
  }
  @media (min-width: 60rem) {
    .split {
      grid-template-columns: minmax(0, 1.85fr) minmax(15rem, 0.85fr);
    }
    .rail {
      border-block-start: 0;
      border-inline-start: var(--pta-rule-width) solid var(--pta-rule);
      padding-inline-start: calc(var(--pta-gap) * 1.5);
    }
  }
  /* Full-bleed tinted band without a wrapper element fighting the container. */
  .band {
    background: var(--pta-surface-alt);
    border-block: var(--pta-rule-width) solid var(--pta-rule);
  }
</style>
