---
import SiteHeader from '../../components/sections/SiteHeader.astro';
import Hero from '../../components/sections/Hero.astro';
import QuickActions from '../../components/sections/QuickActions.astro';
import News from '../../components/sections/News.astro';
import GetInvolved from '../../components/sections/GetInvolved.astro';
import Committees from '../../components/sections/Committees.astro';
import Footer from '../../components/sections/Footer.astro';
import type { HomeData, SiteData } from '../../types';

interface Props {
  home: HomeData;
  site: SiteData;
  /**
   * id for the <main> landmark. /preview renders six structures on one page,
   * and duplicate ids are invalid HTML and confuse assistive tech, so each
   * panel passes its own. Defaults to "main" for real pages.
   */
  mainId?: string;
}
const { home, site, mainId = 'main' } = Astro.props;
---

{/*
  STRUCTURE: utility  →  Quiet Utility

  The only structure that reorders the page: QUICK ACTIONS COME FIRST, above
  the hero. That is the whole argument of this option - most people arriving
  here want to pay dues, sign up, or check a date, and making them scroll past
  a mission statement to do it is a design failure (§2: findability outranks
  visual ambition). The hero becomes a caption rather than a billboard.

  Narrow container, tight rhythm, hairline dividers. Closer to an app screen
  than a brochure.
*/}

<SiteHeader site={site} />
<div class="shell">
  <main id={mainId}>
    <QuickActions quickActions={home.quickActions} />
    <hr />
    <div class="statement"><Hero hero={home.hero} /></div>
    <hr />
    <News news={home.news} />
    <hr />
    <GetInvolved getInvolved={home.getInvolved} />
    <hr />
    <Committees committees={home.committees} />
  </main>
  <Footer footer={home.footer} social={site.social} />
</div>

<style>
  .shell {
    max-width: var(--pta-container);
    margin-inline: auto;
    padding-inline: var(--pta-gutter);
  }
  hr {
    border: 0;
    border-block-start: var(--pta-rule-width) solid var(--pta-rule);
    margin: 0;
  }
  /* Demoted from billboard to standfirst - no bottom rule, hr handles it. */
  .statement :global(.hero) {
    border-block-end: 0;
  }
</style>
