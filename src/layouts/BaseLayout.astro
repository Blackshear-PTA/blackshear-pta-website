---
import { Font, getImage } from 'astro:assets';
import socialSource from '../assets/photos/campus-front-walk.jpg';
import { fontFamilies } from '../font-families.mjs';

/**
 * Astro generates a literal union of the cssVariable names from the `fonts`
 * config. font-families.mjs is plain JS (astro.config.mjs cannot import
 * TypeScript), so its values widen to `string` and will not assign. Deriving
 * the type from the component keeps the cast honest: add a family to the
 * config without adding it to font-families.mjs, or vice versa, and this
 * still type-checks, but `npm run build` fails loudly on the unknown
 * variable rather than silently shipping an undefined --font-*.
 */
type FontVariable = Parameters<typeof Font>[0]['cssVariable'];
import '../styles/global.css';
import '../themes/themes.css';

interface Props {
  title: string;
  description: string;
  /**
   * Sets [data-theme] on <html>; every theme token block hangs off it.
   * Omitted on /preview, where both themes coexist and each panel carries its
   * own [data-theme] instead - the selector works on any element.
   */
  themeId?: string;
}

const { title, description, themeId } = Astro.props;

/**
 * Link-preview image.
 *
 * Without an explicit og:image, scrapers pick something off the page
 * themselves - which is how a shared link ended up previewing with the Staff
 * Appreciation committee thumbnail. This makes the choice ours.
 *
 * Same frame as the page backdrop, but at full strength: the fade there is a
 * scrim applied in CSS so body text stays readable over it, and it is not
 * baked into the file. A preview card has no text on it and wants the photo
 * as shot.
 *
 * 1200x630 rather than a square. Facebook, Slack, LinkedIn and X all crop
 * og:image to roughly 1.91:1, so a square would be centre-cropped to this
 * anyway - by them, not by us, and without the deliberate crop. Astro
 * centre-crops the 3000x2000 source to keep the building, doors and walkway.
 */
const social = await getImage({
  src: socialSource,
  width: 1200,
  height: 630,
  quality: 72,
  format: 'jpg', // some scrapers still will not render webp
});

// Absolute, not relative. Scrapers fetch the image out of the page context and
// a root-relative path resolves against their own host, so the card comes back
// blank.
const socialUrl = new URL(social.src, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const socialAlt = 'The front walkway and entrance of Blackshear Elementary School';
---

<!doctype html>
<html lang="en" data-theme={themeId}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    {/* Open Graph, used by iMessage, WhatsApp, Slack, Facebook and LinkedIn. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Blackshear Elementary PTA" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialUrl} />
    <meta property="og:image:width" content={String(social.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(social.attributes.height ?? 630)} />
    <meta property="og:image:alt" content={socialAlt} />

    {/* X reads its own namespace and ignores og:* for the card type. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialUrl} />
    <meta name="twitter:image:alt" content={socialAlt} />

    {/*
      One <Font> per family - this is what actually emits the @font-face rules
      and defines each --font-* variable. Without it the variables are
      undefined, every --pta-font-display var() chain goes invalid, and both
      themes quietly render in the browser default.

      Deliberately NOT preloaded. /preview holds both themes at once and only
      one is visible; browsers skip font downloads for display:none subtrees,
      so leaving preload off means a visitor fetches the two faces they can
      actually see instead of all four.
    */}
    {fontFamilies.map((f) => <Font cssVariable={f.cssVariable as FontVariable} />)}
    {/*
      Pre-launch only. Weebly is still the canonical site, so this domain must
      not be indexed until cutover (TASKS.md A6). Belt and braces with the
      X-Robots-Tag in public/_headers - a meta tag covers anything that reads
      the HTML but not the response headers. Delete BOTH at cutover.
    */}
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <a class="pta-skip-link" href="#main">Skip to main content</a>
    <slot />
  </body>
</html>
