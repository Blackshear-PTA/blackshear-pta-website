---
/**
 * Buzz, the Blackshear yellow jacket, in a white disc.
 *
 * PROVENANCE; this is not redrawn. assets/brand/buzz-mascot.jpg is flat black
 * line art with no colour information, so it was traced with potrace and the
 * enclosed regions were filled: body and head lemon, wings and teeth white,
 * gloves and shoes brand blue, all outlines and banding black. Every contour
 * comes from the original bitmap, so the shape is byte-for-byte the artwork we
 * were given; only fills were added. The standalone file is at
 * assets/brand/buzz-mascot-color.svg.
 *
 * The colour fills are dilated ~2px so they tuck under the black ink. Without
 * that the tracer leaves hairline white seams between fill and outline that
 * only show up when the mark is scaled up.
 *
 * The disc is themeable (--pta-mark-ground / --pta-mark-ring); the mascot
 * itself is not. It is a real logo now, and a logo that changes colour per
 * theme is not a logo. The disc is what lets it sit on a lemon header band or
 * a near-black one without the yellow body disappearing.
 */
interface Props {
  /** Rendered size in px. Legible down to about 36px. */
  size?: number;
  /**
   * Accessible name. Omit when adjacent text already names the org - the mark
   * is then decorative and gets aria-hidden, which is the common case.
   */
  label?: string;
  class?: string;
}

const { size = 48, label, class: className } = Astro.props;
const decorative = !label;
---

<svg
  class:list={['buzz', className]}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  xmlns="http://www.w3.org/2000/svg"
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={label}
>
  {label && <title>{label}</title>}
