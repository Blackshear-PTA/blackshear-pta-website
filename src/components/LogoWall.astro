---
import { Image } from 'astro:assets';
import type { PageData } from '../types';
import { isExternal } from '../lib/links';

/**
 * A page section's sponsor logos, free-standing on the page, each linking to
 * the sponsor's own site.
 *
 * NO TILES. They used to sit in bordered white boxes; the Fundraising chair
 * asked for them loose on the page, as the old site had them (2026-10-24). The
 * page is white, so the logos drawn on a white ground still blend in.
 *
 * EVERY LOGO GETS ABOUT THE SAME AREA, not the same width or height. Logos come
 * in every shape: a wide wordmark sized to a box's width looks tiny, and a
 * square badge sized to its height looks huge. Giving each one the same area
 * and capping both sides makes a row read as even, which is what the chair's
 * "dimension guidelines" came down to. The size comes from the file's own
 * proportions, so a new logo needs no setting.
 *
 * `moreLogos` are a lower tier, drawn at about 80% of that size (TASKS.md
 * A51). They go in the SAME list, straight after `logos`, so the rows run on
 * without a gap. As a second list they started on a new line, which left a
 * hole at the end of the first whenever its last row was short (Jon,
 * 2026-10-26). The smaller size is what marks the tier.
 *
 * Not in the lightbox: a logo is a link to the business, not a picture to
 * look at.
 */
type Logos = PageData['sections'][number]['logos'];

interface Props {
  logos: Logos;
  moreLogos?: Logos;
}

const { logos, moreLogos = [] } = Astro.props;

/** The area every logo gets, in rem²: a 2:1 wordmark comes out about 9 × 4.5. */
const AREA = 40;
/** The most any logo may take on either side, so no shape runs away. */
const MAX_WIDTH = 11;
const MAX_HEIGHT = 5.5;
/** Width and height for the smaller tier: 80% each way, about two thirds the area. */
const SMALL = 0.8;

function boxFor(width: number, height: number, scale: number) {
  const ratio = width / height;
  let w = Math.sqrt(AREA * ratio);
  let h = w / ratio;
  if (w > MAX_WIDTH) { w = MAX_WIDTH; h = w / ratio; }
  if (h > MAX_HEIGHT) { h = MAX_HEIGHT; w = h * ratio; }
  return { w: Math.round(w * scale * 100) / 100, h: Math.round(h * scale * 100) / 100 };
}

const sized = [
  ...logos.map((logo) => ({ ...logo, box: boxFor(logo.src.width, logo.src.height, 1) })),
  ...moreLogos.map((logo) => ({ ...logo, box: boxFor(logo.src.width, logo.src.height, SMALL) })),
];
---

{
  sized.length > 0 && (
    <ul class="logo-wall">
      {sized.map((logo) => {
        const picture = (
          <Image
            src={logo.src}
            alt={logo.name}
            width={Math.ceil(logo.box.w * 16)}
            densities={[1, 2]}
            loading="lazy"
            style={`width:${logo.box.w}rem;height:${logo.box.h}rem`}
          />
        );
        return (
          <li>
            {logo.href ? (
              <a
                href={logo.href}
                title={logo.name}
                target={isExternal(logo.href) ? '_blank' : undefined}
                rel={isExternal(logo.href) ? 'noopener' : undefined}
              >
                {picture}
              </a>
            ) : (
              <span title={logo.name}>{picture}</span>
            )}
          </li>
        );
      })}
    </ul>
  )
}

<style>
  .logo-wall {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.75rem 2.5rem;
    margin: 0.5rem 0 var(--pta-gap);
    padding: 0;
    list-style: none;
  }

  a,
  span {
    display: block;
  }

  a {
    border-radius: var(--pta-radius);
    transition: transform 0.15s ease;
  }

  a:hover {
    transform: translateY(-2px);
  }

  a:focus-visible {
    outline: 3px solid var(--pta-accent);
    outline-offset: 6px;
  }

  img {
    display: block;
    max-width: 100%;
    object-fit: contain;
  }
</style>
