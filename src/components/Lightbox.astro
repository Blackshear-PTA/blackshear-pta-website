---
/**
 * Full-size photo viewer for any link marked `data-lightbox="<group>"`.
 *
 * Progressive enhancement, on purpose. Each thumbnail is a real link to the
 * full-size file, so with the script blocked, failed or not yet loaded, a click
 * still opens the photo - the browser's own image view. The script only swaps
 * that for this dialog and adds previous / next within the same group.
 *
 * Native <dialog> for the same reasons as the calendar's event details:
 * showModal() gives the focus trap, the inert page behind it, Escape to close
 * and focus returned to the thumbnail afterwards, none of which a div would get
 * right on its own.
 *
 * One per page. The groups keep each year's photos to themselves, so "next" on
 * the last 2025 photo stops rather than wandering into 2024.
 *
 * Zoom, for pictures bigger than the screen can fit. Fitting a tall poster into
 * a laptop's height shows it no larger than the page already did, which is no
 * use to someone who opened it to read the small print (Jon, 2026-10-27). The
 * Zoom button, or a tap on the picture, shows it at up to its own size in a
 * box that scrolls. Offered only when that is meaningfully bigger, so an
 * already-small photo is never blown up into a blur.
 */
---

<dialog class="lightbox" data-lightbox-dialog aria-label="Photo viewer">
  <figure class="lb-figure">
    <div class="lb-frame" data-lb-frame>
      <img data-lb-img alt="" />
    </div>
    <figcaption>
      <span data-lb-caption></span>
      <span class="lb-count" data-lb-count></span>
    </figcaption>
  </figure>

  <div class="lb-actions">
    <button type="button" class="lb-btn" data-lb-prev>
      <span aria-hidden="true">&larr;</span> Previous
    </button>
    <button type="button" class="lb-btn" data-lb-next>
      Next <span aria-hidden="true">&rarr;</span>
    </button>
    <button type="button" class="lb-btn" data-lb-zoom aria-pressed="false" hidden>Zoom in</button>
    <button type="button" class="lb-btn lb-close" data-lb-close>Close</button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');

  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-lb-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-lb-next]')!;
    const frame = dialog.querySelector<HTMLElement>('[data-lb-frame]')!;
    const zoom = dialog.querySelector<HTMLButtonElement>('[data-lb-zoom]')!;

    let group: HTMLAnchorElement[] = [];
    let index = 0;

    /**
     * Zoomed, the picture fills the viewer's width, which on a laptop is about
     * twice its fitted size, and scrolls up and down. A phone's viewer is barely
     * wider than the fitted picture, so below this width it goes to three times
     * the viewer and scrolls both ways. Never past the file's own size.
     */
    const PHONE_WIDTH = 640;

    const setZoom = (on: boolean) => {
      // Class first: the width is measured once the frame scrolls, so a
      // scrollbar that takes up room is already out of it.
      frame.classList.toggle('is-zoomed', on);
      const width = frame.clientWidth < PHONE_WIDTH ? frame.clientWidth * 3 : frame.clientWidth;
      img.style.width = on ? `${Math.min(img.naturalWidth, width)}px` : '';
      zoom.textContent = on ? 'Fit to screen' : 'Zoom in';
      zoom.setAttribute('aria-pressed', String(on));
    };

    // Worth offering only when zooming would show the picture at least a
    // quarter bigger than it is fitted. `contain` scales by the tighter side.
    img.addEventListener('load', () => {
      const box = img.getBoundingClientRect();
      const fitted = Math.min(box.width / img.naturalWidth, box.height / img.naturalHeight);
      zoom.hidden = !(fitted < 0.8);
      frame.classList.toggle('can-zoom', !zoom.hidden);
    });

    // A tap on the picture zooms in towards that spot, and a second tap fits it
    // back. Scrolling a zoomed picture on a phone does not count as a tap.
    img.addEventListener('click', (event) => {
      if (zoom.hidden) return;
      if (frame.classList.contains('is-zoomed')) {
        setZoom(false);
        return;
      }
      const box = img.getBoundingClientRect();
      const fx = (event.clientX - box.left) / box.width;
      const fy = (event.clientY - box.top) / box.height;
      setZoom(true);
      frame.scrollLeft = fx * frame.scrollWidth - frame.clientWidth / 2;
      frame.scrollTop = fy * frame.scrollHeight - frame.clientHeight / 2;
    });

    zoom.addEventListener('click', () => setZoom(!frame.classList.contains('is-zoomed')));

    const show = (i: number) => {
      index = Math.max(0, Math.min(group.length - 1, i));
      const link = group[index];
      if (!link) return;
      const alt = link.querySelector('img')?.alt ?? '';
      setZoom(false);
      zoom.hidden = true;
      frame.classList.remove('can-zoom');
      img.src = link.href;
      img.alt = alt;
      caption.textContent = link.dataset.caption || alt;
      count.textContent = group.length > 1 ? `${index + 1} of ${group.length}` : '';
      prev.hidden = next.hidden = group.length < 2;
      prev.disabled = index === 0;
      next.disabled = index === group.length - 1;
    };

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest<HTMLAnchorElement>('a[data-lightbox]');
      // A modified click is someone asking for a new tab. Let them have it.
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      group = [
        ...document.querySelectorAll<HTMLAnchorElement>(
          `a[data-lightbox="${CSS.escape(link.dataset.lightbox ?? '')}"]`,
        ),
      ];
      show(group.indexOf(link));
      dialog.showModal();
    });

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });

    // A click on the dimmed backdrop lands on the dialog element itself.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    // Drop the image on close, so a large photo is not held for a page that has
    // moved on, and the next open never flashes the previous photo.
    dialog.addEventListener('close', () => {
      setZoom(false);
      img.removeAttribute('src');
    });
  }
</script>

<style>
  .lightbox {
    width: min(64rem, calc(100vw - 2rem));
    /* The site-wide dialog rule caps the height; this one fills it, so the photo
       can use the screen rather than a fixed box. */
    height: min(85vh, 100% - 2rem);
    padding: 0.75rem;
    border: var(--pta-border-width) solid var(--pta-ink);
    border-radius: var(--pta-radius);
    background: var(--pta-surface);
    color: var(--pta-ink);
  }

  .lightbox[open] {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.75);
  }

  .lb-figure {
    flex: 1;
    min-height: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .lb-frame {
    flex: 1;
    min-height: 0;
  }

  /* Contained, never cropped: this is the one place the whole photo shows. */
  .lb-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Zoomed: the picture at the width the script sets, in a box that scrolls. */
  .lb-frame.is-zoomed {
    overflow: auto;
  }

  .lb-frame.is-zoomed img {
    max-width: none;
    height: auto;
    cursor: zoom-out;
  }

  .lb-frame.can-zoom:not(.is-zoomed) img {
    cursor: zoom-in;
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    gap: var(--pta-gap);
    font-size: var(--text-fine);
  }

  .lb-count {
    flex: none;
    color: var(--pta-ink-muted);
  }

  .lb-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .lb-close {
    margin-inline-start: auto;
  }

  .lb-btn {
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: var(--pta-border-width) solid var(--pta-rule);
    border-radius: var(--pta-radius);
    background: var(--pta-surface);
    color: var(--pta-ink);
    font-family: var(--pta-font-display);
    font-weight: var(--pta-display-weight);
    font-size: var(--text-fine);
    cursor: pointer;
  }

  .lb-btn:hover:not(:disabled) {
    background: var(--pta-accent);
    color: var(--pta-ink-on-accent);
  }

  .lb-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
</style>
