---
import { uid } from '../../uid';
import type { HomeData } from '../../types';

interface Props {
  getInvolved: HomeData['getInvolved'];
}

const { getInvolved } = Astro.props;

// Unique per render: /preview puts every design on one page, so a hardcoded
// id would ship once per design and aria-labelledby would be ambiguous.
const headingId = uid('get-involved-heading');
---

{/*
  Deliberately built as the same object as QuickActions: bordered tile, whole
  tile is the link, accent fill on hover. Two adjacent sections that are both
  "here are some things you can click" should not look like they came from
  different sites, which is how this read before.

  The tile no longer paints its own alt background. Whether this section sits
  in a tinted band is a STRUCTURE decision - `editorial` bands it, the others
  leave it on the page surface - and a component reaching up to colour its own
  container took that choice away from them.
*/}

<section class="get-involved" aria-labelledby={headingId}>
  <h2 id={headingId}>{getInvolved.heading}</h2>
  {getInvolved.intro && <p class="intro">{getInvolved.intro}</p>}
  <ul>
    {
      getInvolved.tiers.map((tier) => (
        <li>
          <a href={tier.cta.href}>
            {/* Time cost first, not job title - that is the point of the block. */}
            <span class="commitment">{tier.commitment}</span>
            <span class="description">{tier.description}</span>
            <span class="cta">{tier.cta.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .get-involved {
    padding-block: var(--pta-section-y);
  }

  h2 {
    margin: 0 0 var(--pta-gap);
    font-family: var(--pta-font-display);
    font-size: var(--text-title);
    font-weight: var(--pta-display-weight);
    letter-spacing: var(--pta-display-tracking);
    text-transform: var(--pta-display-transform);
  }

  .intro {
    margin: 0 0 var(--pta-gap);
    max-width: var(--pta-measure);
  }

  ul {
    display: grid;
    gap: var(--pta-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 52rem) {
    ul {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--pta-gap);
    border: var(--pta-border-width) solid var(--pta-rule);
    border-radius: var(--pta-radius);
    box-shadow: var(--pta-shadow);
    color: var(--pta-ink);
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    background: var(--pta-accent);
    color: var(--pta-ink-on-accent);
  }

  .commitment {
    display: block;
    font-family: var(--pta-font-display);
    font-size: var(--text-lede);
    font-weight: var(--pta-display-weight);
    letter-spacing: var(--pta-display-tracking);
    text-transform: var(--pta-display-transform);
    line-height: var(--leading-snug);
  }

  .description {
    display: block;
    margin-block: 0.5rem var(--pta-gap);
    /* Pushes the CTA to the bottom so tiles in a row line up. */
    flex: 1;
  }

  .cta {
    display: block;
    font-family: var(--pta-font-display);
    font-weight: var(--pta-display-weight);
    font-size: var(--text-fine);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .cta::after {
    content: ' \2192';
  }
</style>
