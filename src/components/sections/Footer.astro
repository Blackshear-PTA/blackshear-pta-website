---
import type { HomeData, SiteData } from '../../types';

interface Props {
  footer: HomeData['footer'];
  social?: SiteData['social'];
}

const { footer, social = [] } = Astro.props;
const { contact } = footer;

// Strip everything but digits so tel: works from a phone (§2: mobile-first).
const telHref = `tel:${contact.phone.replace(/[^\d+]/g, '')}`;

/**
 * Simplified glyphs drawn as paths rather than the platforms' official brand
 * assets. Two reasons: they inherit currentColor, so the same markup works on
 * Civic's white ground and Print Shop's newsprint without shipping a
 * recoloured PNG per theme; and it avoids bundling third-party brand files whose usage
 * terms someone would otherwise have to keep track of.
 */
const glyphs = {
  instagram: [
    'M7 3.5h10A3.5 3.5 0 0 1 20.5 7v10a3.5 3.5 0 0 1-3.5 3.5H7A3.5 3.5 0 0 1 3.5 17V7A3.5 3.5 0 0 1 7 3.5Z',
    'M12 8.6A3.4 3.4 0 1 1 12 15.4a3.4 3.4 0 0 1 0-6.8Z',
    'M17.3 6.9v.01',
  ],
  facebook: [
    'M13.6 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5H16.8V3.6A21 21 0 0 0 14.4 3.5c-2.4 0-4 1.45-4 4.1v2.3H7.7V13h2.7v8Z',
  ],
  email: [
    'M3.5 6.5h17v11h-17z',
    'M3.5 7 12 13l8.5-6',
  ],
} as const;
---

<footer class="footer">
  <div class="footer-inner">
    <div class="details">
      <p class="org">{footer.orgName}</p>
      <address>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <a href={telHref}>{contact.phone}</a>
        <span>{contact.address}</span>
      </address>
    </div>

    {
      social.length > 0 && (
        <ul class="social">
          {social.map((item) => (
            <li>
              <a
                href={item.href}
                aria-label={item.label}
                target={item.href.startsWith('mailto:') ? undefined : '_blank'}
                rel={item.href.startsWith('mailto:') ? undefined : 'noopener'}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24">
                  {glyphs[item.platform].map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--pta-section-y);
    border-block-start: var(--pta-rule-width) solid var(--pta-rule);
  }

  /* Details left, follow links right, as far apart as the container allows.
     Stacks below 34rem so the icons stay a comfortable thumb reach rather
     than being squeezed against the address. */
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pta-gap);
    align-items: flex-end;
    justify-content: space-between;
  }

  .org {
    margin: 0 0 var(--pta-gap);
    font-family: var(--pta-font-display);
    font-weight: var(--pta-display-weight);
    text-transform: var(--pta-display-transform);
  }

  address {
    display: grid;
    gap: 0.25rem;
    font-style: normal;
    font-size: var(--text-fine);
  }

  .social {
    display: flex;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social a {
    display: grid;
    place-items: center;
    /* 44px target even though the glyph is 24px. */
    width: 44px;
    height: 44px;
    border: var(--pta-border-width) solid transparent;
    border-radius: var(--pta-radius);
    color: var(--pta-ink);
  }

  .social a:hover,
  .social a:focus-visible {
    border-color: var(--pta-rule);
    background: var(--pta-accent);
    color: var(--pta-ink-on-accent);
  }

  .social path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The f is a filled mark; outlining it reads as a hollow letter, not a logo. */
  .social li:nth-child(n) svg path[d^='M13.6'] {
    fill: currentColor;
    stroke: none;
  }
</style>
