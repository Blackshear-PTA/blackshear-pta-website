---
import { Image } from 'astro:assets';
import littleEast from '../../assets/photos/little-east.jpg';
import bakeSale from '../../assets/photos/bake-sale.jpg';
import garden from '../../assets/photos/garden.jpg';
import campusFlagpole from '../../assets/photos/campus-flagpole.jpg';
import { uid } from '../../uid';
import type { HomeData } from '../../types';

interface Props {
  committees: HomeData['committees'];
}

const { committees } = Astro.props;

// Unique per render: /preview puts every design on one page, so a hardcoded
// id would ship once per design and aria-labelledby would be ambiguous.
const headingId = uid('committees-heading');

/**
 * Slug to image. Static imports rather than paths built from content, because
 * Astro's build-time pipeline can only resize and re-encode what it can see
 * imported. `little-east.jpg` is a 4MB phone photo; served raw it would be the
 * heaviest thing on the page by an order of magnitude.
 *
 * Passing a square width/height against a non-square source makes Astro centre
 * -crop rather than squash, which is what we want for a thumbnail grid.
 */
const art = {
  'little-east': { src: littleEast, alt: 'Student paintings covering a wall at Blackshear' },
  // Slug follows the committee, not the filename: the photo is still a garden,
  // but a committee named Campus Beautification carrying `art: garden` reads as
  // a mistake to the next person editing home.yaml.
  'campus-beautification': {
    src: garden,
    alt: 'A raised garden bed of black-eyed Susans and lantana',
  },
  'staff-appreciation': {
    src: campusFlagpole,
    alt: 'The flagpole and main building on the Blackshear campus',
  },
  fundraising: { src: bakeSale, alt: 'Trays of baked goods laid out on a PTA bake sale table' },
} as const;
---

<section class="committees" aria-labelledby={headingId}>
  <h2 id={headingId}>{committees.heading}</h2>
  {committees.intro && <p class="intro">{committees.intro}</p>}
  <ul>
    {
      committees.items.map((committee) => {
        const photo = committee.art ? art[committee.art] : null;
        // Whole tile is the link when there is a page to go to, matching
        // QuickActions and GetInvolved. A committee with no page yet stays
        // plain text rather than becoming a link to nowhere.
        const Tile = committee.href ? 'a' : 'div';
        return (
          <li>
            <Tile class="tile" href={committee.href}>
              {photo && (
                <div class="art">
                  <Image
                    src={photo.src}
                    alt={photo.alt}
                    width={220}
                    height={220}
                    densities={[1, 2]}
                    loading="lazy"
                  />
                </div>
              )}
              <div class="text">
                <h3>{committee.name}</h3>
                <p>{committee.description}</p>
                {committee.href && <span class="more">Read more</span>}
              </div>
            </Tile>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .committees {
    padding-block: var(--pta-section-y);
  }

  h2 {
    margin: 0 0 var(--pta-gap);
    font-family: var(--pta-font-display);
    font-size: var(--text-title);
    font-weight: var(--pta-display-weight);
    letter-spacing: var(--pta-display-tracking);
    text-transform: var(--pta-display-transform);
  }

  .intro {
    margin: 0 0 var(--pta-gap);
    max-width: var(--pta-measure);
  }

  ul {
    display: grid;
    gap: var(--pta-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 46rem) {
    ul {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  li {
    border-block-start: var(--pta-border-width) solid var(--pta-rule);
  }

  .tile {
    display: flex;
    gap: var(--pta-gap);
    align-items: flex-start;
    padding-block: var(--pta-gap);
    color: var(--pta-ink);
    text-decoration: none;
  }

  a.tile:hover,
  a.tile:focus-visible {
    background: var(--pta-accent);
    color: var(--pta-ink-on-accent);
    /* Bleeds the fill to the edge of the tile rather than stopping at the text
       column, so the hover reads as "this whole row is the target". */
    padding-inline: var(--pta-gap);
    margin-inline: calc(-1 * var(--pta-gap));
  }

  .more {
    display: block;
    margin-block-start: 0.4rem;
    font-family: var(--pta-font-display);
    font-weight: var(--pta-display-weight);
    font-size: var(--text-fine);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .more::after {
    content: ' \2192';
  }

  .art {
    flex: none;
    width: 5.5rem;
    height: 5.5rem;
    overflow: hidden;
    border: var(--pta-border-width) solid var(--pta-rule);
    border-radius: var(--pta-radius);
    background: var(--pta-surface-alt);
  }

  .art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .text {
    min-width: 0;
  }

  h3 {
    margin: 0;
    font-family: var(--pta-font-display);
    font-size: var(--text-body);
    font-weight: var(--pta-display-weight);
    letter-spacing: var(--pta-display-tracking);
    text-transform: var(--pta-display-transform);
    line-height: var(--leading-snug);
  }

  p {
    margin: 0.35rem 0 0;
    font-size: var(--text-fine);
    color: var(--pta-ink-muted);
  }
</style>
