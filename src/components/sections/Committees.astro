---
import { Image } from 'astro:assets';
import littleEast from '../../assets/photos/little-east.jpg';
import bakeSale from '../../assets/photos/bake-sale.jpg';
import garden from '../../assets/photos/garden.jpg';
import blackshearFront from '../../assets/photos/blackshear-front.jpg';
import type { HomeData } from '../../types';

interface Props {
  committees: HomeData['committees'];
}

const { committees } = Astro.props;

/**
 * Slug to image. Static imports rather than paths built from content, because
 * Astro's build-time pipeline can only resize and re-encode what it can see
 * imported. `little-east.jpg` is a 4MB phone photo; served raw it would be the
 * heaviest thing on the page by an order of magnitude.
 *
 * Passing a square width/height against a non-square source makes Astro centre
 * -crop rather than squash, which is what we want for a thumbnail grid.
 */
const art = {
  'little-east': { src: littleEast, alt: 'Student paintings covering a wall at Blackshear' },
  garden: { src: garden, alt: 'A raised garden bed of black-eyed Susans and lantana' },
  'staff-appreciation': {
    src: blackshearFront,
    alt: 'The Blackshear Elementary building on East 11th Street',
  },
  fundraising: { src: bakeSale, alt: 'Trays of baked goods laid out on a PTA bake sale table' },
} as const;
---

<section class="committees" aria-labelledby="committees-heading">
  <h2 id="committees-heading">{committees.heading}</h2>
  {committees.intro && <p class="intro">{committees.intro}</p>}
  <ul>
    {
      committees.items.map((committee) => {
        const photo = committee.art ? art[committee.art] : null;
        return (
          <li>
            {photo && (
              <div class="art">
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  width={220}
                  height={220}
                  densities={[1, 2]}
                  loading="lazy"
                />
              </div>
            )}
            <div class="text">
              <h3>{committee.name}</h3>
              <p>{committee.description}</p>
            </div>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .committees {
    padding-block: var(--pta-section-y);
  }

  h2 {
    margin: 0 0 var(--pta-gap);
    font-family: var(--pta-font-display);
    font-size: var(--text-title);
    font-weight: var(--pta-display-weight);
    letter-spacing: var(--pta-display-tracking);
    text-transform: var(--pta-display-transform);
  }

  .intro {
    margin: 0 0 var(--pta-gap);
    max-width: var(--pta-measure);
  }

  ul {
    display: grid;
    gap: var(--pta-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 46rem) {
    ul {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  li {
    display: flex;
    gap: var(--pta-gap);
    align-items: flex-start;
    padding-block: var(--pta-gap);
    border-block-start: var(--pta-border-width) solid var(--pta-rule);
  }

  .art {
    flex: none;
    width: 5.5rem;
    height: 5.5rem;
    overflow: hidden;
    border: var(--pta-border-width) solid var(--pta-rule);
    border-radius: var(--pta-radius);
    background: var(--pta-surface-alt);
  }

  .art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .text {
    min-width: 0;
  }

  h3 {
    margin: 0;
    font-family: var(--pta-font-display);
    font-size: var(--text-body);
    font-weight: var(--pta-display-weight);
    letter-spacing: var(--pta-display-tracking);
    text-transform: var(--pta-display-transform);
    line-height: var(--leading-snug);
  }

  p {
    margin: 0.35rem 0 0;
    font-size: var(--text-fine);
    color: var(--pta-ink-muted);
  }
</style>
