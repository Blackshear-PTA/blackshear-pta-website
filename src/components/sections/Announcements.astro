---
import { uid } from '../../uid';
import PostBadges from '../PostBadges.astro';
import {
  formatDate,
  postDate,
  postPath,
  coverImage,
  imageUrl,
  excerpt,
  type Post,
} from '../../lib/announcements';
import type { HomeData } from '../../types';

/**
 * The homepage announcements block. Was "What's happening"; renamed so the
 * homepage, the nav, the index page and the feed all call this one thing by
 * one name.
 *
 * PURELY PRESENTATIONAL: it is handed its posts rather than fetching them.
 *
 * It used to call getAnnouncements() itself, which was fine while that read a
 * content collection at build time. Now it would be a database read, and this
 * component is rendered by both structures, which are rendered by BOTH the
 * homepage and /preview - so a self-fetching component would either drag
 * /preview into on-demand rendering by accident, or run three queries there to
 * answer one question. Taking props makes the page that owns the request own
 * the read, which is where the decision belongs and where it is visible.
 */
interface Props {
  announcements: HomeData['announcements'];
  /** Already filtered, ordered and limited. See src/lib/announcements.ts. */
  posts: Post[];
  /** Every published post, not just the ones passed - drives "see all N". */
  total: number;
}

const { announcements, posts, total } = Astro.props;

// Unique per render: /preview puts every design on one page, so a hardcoded
// id would ship once per design and aria-labelledby would be ambiguous.
const headingId = uid('announcements-heading');
---

<section class="announcements" aria-labelledby={headingId}>
  <h2 id={headingId}>{announcements.heading}</h2>
  <ul>
    {
      posts.map((post) => {
        const cover = coverImage(post);
        return (
          <li>
            <time datetime={postDate(post.date).toISOString()}>{formatDate(post.date)}</time>
            <h3>
              <a href={postPath(post)}>{post.title}</a>
            </h3>
            <PostBadges pinned={post.pinned} grades={post.grades} />
            {cover && (
              <a class="cover" href={postPath(post)} tabindex="-1" aria-hidden="true">
                <img src={imageUrl(cover.key)} alt={cover.alt} loading="lazy" decoding="async" />
              </a>
            )}
            <p>{excerpt(post)}</p>
          </li>
        );
      })
    }
  </ul>

  {
    total > posts.length && (
      <p class="more">
        <a href="/announcements">See all {total} announcements</a>
      </p>
    )
  }
</section>

<style>
  .announcements {
    padding-block: var(--pta-section-y);
    border-block-start: var(--pta-rule-width) solid var(--pta-rule);
  }

  h2 {
    margin: 0 0 var(--pta-gap);
    font-family: var(--pta-font-display);
    font-size: var(--text-title);
    font-weight: var(--pta-display-weight);
    letter-spacing: var(--pta-display-tracking);
    text-transform: var(--pta-display-transform);
  }

  ul {
    display: grid;
    gap: var(--pta-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    max-width: var(--pta-measure);
    padding-block-end: var(--pta-gap);
    border-block-end: var(--pta-border-width) solid var(--pta-rule);
  }

  time {
    display: block;
    font-size: var(--text-fine);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--pta-ink-muted);
  }

  h3 {
    margin: 0.25rem 0 0;
    font-family: var(--pta-font-display);
    font-size: var(--text-lede);
    font-weight: var(--pta-display-weight);
  }

  /* aspect-ratio rather than width/height: these come from R2, so the build
     never sees the file and cannot know its dimensions. Without a reserved box
     the text below shifts when the photo loads, which is the same layout-shift
     problem the font preloading fixed. */
  .cover {
    display: block;
    margin-block: var(--pta-gap) 0;
  }

  .cover img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: var(--pta-border-width) solid var(--pta-rule);
    border-radius: var(--pta-radius);
    background: var(--pta-surface-alt);
  }

  p {
    margin: var(--pta-gap) 0 0;
  }

  .more {
    margin-block-start: var(--pta-gap);
  }

  .more a {
    display: inline-flex;
    align-items: center;
    /* Genuine 44px target without a visible box; padding alone lands short. */
    min-height: 44px;
    font-family: var(--pta-font-display);
    font-weight: var(--pta-display-weight);
    font-size: var(--text-fine);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--pta-ink);
  }

  .more a::after {
    content: ' \2192';
  }
</style>
