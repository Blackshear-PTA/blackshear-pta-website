---
import { uid } from '../../uid';
import { getAnnouncements, formatDate } from '../../lib/announcements';
import { isExternal } from '../../lib/links';
import type { HomeData } from '../../types';

interface Props {
  news: HomeData['news'];
}

const { news } = Astro.props;

// Unique per render: /preview puts every design on one page, so a hardcoded
// id would ship once per design and aria-labelledby would be ambiguous.
const headingId = uid('news-heading');

/**
 * Posts come from the announcements collection, not from home.yaml. The
 * homepage shows the most recent few; /news has all of them. Ordering and
 * draft filtering live in one place so this block, /news and the RSS feed
 * cannot disagree about what is published.
 */
const posts = await getAnnouncements(news.limit);
const total = (await getAnnouncements()).length;
---

<section class="news" aria-labelledby={headingId}>
  <h2 id={headingId}>{news.heading}</h2>
  <ul>
    {
      posts.map((post) => (
        <li>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <h3>
            {
              post.data.href ? (
                <a
                  href={post.data.href}
                  target={isExternal(post.data.href) ? '_blank' : undefined}
                  rel={isExternal(post.data.href) ? 'noopener' : undefined}
                >
                  {post.data.title}
                  {isExternal(post.data.href) && (
                    <span class="sr-only"> (opens in a new tab)</span>
                  )}
                </a>
              ) : (
                post.data.title
              )
            }
          </h3>
          {post.data.image && (
            <img
              class="photo"
              src={`/images/${post.data.image}`}
              alt={post.data.imageAlt}
              loading="lazy"
              decoding="async"
            />
          )}
          <p>{post.body}</p>
        </li>
      ))
    }
  </ul>

  {total > posts.length && (
    <p class="more">
      <a href="/news">See all {total} announcements</a>
    </p>
  )}
</section>

<style>
  .news {
    padding-block: var(--pta-section-y);
    border-block-start: var(--pta-rule-width) solid var(--pta-rule);
  }

  h2 {
    margin: 0 0 var(--pta-gap);
    font-family: var(--pta-font-display);
    font-size: var(--text-title);
    font-weight: var(--pta-display-weight);
    letter-spacing: var(--pta-display-tracking);
    text-transform: var(--pta-display-transform);
  }

  ul {
    display: grid;
    gap: var(--pta-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    max-width: var(--pta-measure);
    padding-block-end: var(--pta-gap);
    border-block-end: var(--pta-border-width) solid var(--pta-rule);
  }

  time {
    display: block;
    font-size: var(--text-fine);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--pta-ink-muted);
  }

  h3 {
    margin: 0.25rem 0 0.5rem;
    font-family: var(--pta-font-display);
    font-size: var(--text-lede);
    font-weight: var(--pta-display-weight);
  }

  p {
    margin: 0;
  }

  /* aspect-ratio rather than width/height: these come from R2, so the build
     never sees the file and cannot know its dimensions. Without a reserved box
     the text below shifts when the photo loads, which is the same layout-shift
     problem the font preloading fixed. */
  .photo {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    margin-block: 0.5rem var(--pta-gap);
    border: var(--pta-border-width) solid var(--pta-rule);
    border-radius: var(--pta-radius);
    background: var(--pta-surface-alt);
  }

  .more {
    margin-block-start: var(--pta-gap);
  }

  .more a {
    display: inline-flex;
    align-items: center;
    /* Genuine 44px target without a visible box; padding alone lands short. */
    min-height: 44px;
    font-family: var(--pta-font-display);
    font-weight: var(--pta-display-weight);
    font-size: var(--text-fine);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--pta-ink);
  }

  .more a::after {
    content: ' \2192';
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
