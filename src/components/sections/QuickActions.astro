---
import { uid } from '../../uid';
import { isExternal } from '../../lib/links';
import type { HomeData } from '../../types';

interface Props {
  quickActions: HomeData['quickActions'];
}

const { quickActions } = Astro.props;

// Unique per render: /preview puts every design on one page, so a hardcoded
// id would ship once per design and aria-labelledby would be ambiguous.
const headingId = uid('quick-actions-heading');
---

<section class="quick-actions" aria-labelledby={headingId}>
  <h2 id={headingId}>{quickActions.heading}</h2>
  <ul>
    {
      quickActions.items.map((item) => (
        <li>
          <a
            href={item.href}
            target={isExternal(item.href) ? '_blank' : undefined}
            rel={isExternal(item.href) ? 'noopener' : undefined}
          >
            <span class="label">
              {item.label}
              {isExternal(item.href) && (
                <svg class="ext" viewBox="0 0 12 12" aria-hidden="true" width="9" height="9">
                  <path d="M4 2h6v6M10 2 3 9" fill="none" stroke="currentColor"
                    stroke-width="1.75" stroke-linecap="round" />
                </svg>
              )}
              {isExternal(item.href) && <span class="sr-only"> (opens in a new tab)</span>}
            </span>
            {item.note && <span class="note">{item.note}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</section>

{/*
  Half of these tiles now go to our own pages and half hand off to Zeffy or a
  sign-up form. Before the site had its own Volunteer and Calendar pages they
  were all outbound and the distinction did not exist; now it does, and the
  header already marks external links, so not marking them here would be the
  site contradicting itself on the same screen.

  External-ness is derived from the href, not declared in content - see
  src/lib/links.ts for why.
*/}

<style>
  .ext {
    opacity: 0.65;
    margin-inline-start: 0.25em;
    vertical-align: baseline;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .quick-actions {
    padding-block: var(--pta-section-y);
  }

  h2 {
    margin: 0 0 var(--pta-gap);
    font-family: var(--pta-font-display);
    font-size: var(--text-title);
    font-weight: var(--pta-display-weight);
    letter-spacing: var(--pta-display-tracking);
    text-transform: var(--pta-display-transform);
  }

  ul {
    display: grid;
    gap: var(--pta-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Mobile-first (§2). One column until there is room for more. */
  @media (min-width: 40rem) {
    ul {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  a {
    display: block;
    padding: var(--pta-gap);
    border: var(--pta-border-width) solid var(--pta-rule);
    border-radius: var(--pta-radius);
    box-shadow: var(--pta-shadow);
    color: var(--pta-ink);
    text-decoration: none;
  }

  a:hover {
    background: var(--pta-accent);
    color: var(--pta-ink-on-accent);
  }

  .label {
    display: block;
    font-family: var(--pta-font-display);
    font-weight: var(--pta-display-weight);
  }

  .note {
    display: block;
    font-size: var(--text-fine);
    color: inherit;
  }
</style>
