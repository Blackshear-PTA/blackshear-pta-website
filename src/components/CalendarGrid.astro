---
import BuzzMascot from './BuzzMascot.astro';

/**
 * A month-at-a-time calendar, built to be read on a phone and printed on one
 * sheet of paper.
 *
 * WHY A TABLE. A calendar is a grid of days indexed by weekday and week, which
 * is what a table is for. It also gives the print layout something sensible to
 * break on, and a screen reader a way to say "Wednesday the 12th" rather than
 * reading forty cells in a row.
 *
 * WHY EVERY MONTH IS RENDERED AT ONCE. The site is static, so a month picker
 * that changed the URL would need a page per month and a rebuild whenever the
 * window moved. Instead every month in the snapshot is in the HTML and the
 * arrows just change which one is visible. It costs a few kilobytes and the
 * navigation is instant.
 *
 * ALL DATES ARE COMPUTED IN AMERICA/CHICAGO. Events arrive as UTC instants. A
 * 7pm meeting is 00:00 the next day in UTC, so grouping on the UTC date puts
 * half the evening events on the wrong square - the kind of bug that looks
 * like nothing until somebody misses a meeting.
 */

interface CalendarEvent {
  id: string;
  title: string;
  start: string;
  end?: string;
  allDay?: boolean;
  location?: string;
  /** Google Calendar's own notes field, shown in the details dialog. */
  description?: string;
}

interface Props {
  events: CalendarEvent[];
  /** How many months of history to keep reachable behind the arrows. */
  monthsBack?: number;
}

const { events, monthsBack = 1 } = Astro.props;

const TZ = 'America/Chicago';

/**
 * The calendar date an instant falls on, in school time, as YYYY-MM-DD.
 * en-CA gives ISO order directly, which avoids reassembling parts by hand.
 */
const dayKeyParts = { year: 'numeric', month: '2-digit', day: '2-digit' } as const;
const dayKeyFmt = new Intl.DateTimeFormat('en-CA', { timeZone: TZ, ...dayKeyParts });

/**
 * All-day events carry a CALENDAR DATE, not an instant, and must not be
 * converted to a zone.
 *
 * ical.ts builds one as `Date.UTC(y, m-1, d)` - midnight UTC standing in for
 * "September 15", with no time of day meant by it. Chicago is five hours behind
 * UTC, so formatting that instant in school time gives 7pm on September 14, and
 * the event was placed on the 14th AND the 15th. Every staff birthday and every
 * school holiday appeared twice, on two adjacent squares, which read as the
 * feed containing duplicates rather than as a timezone bug.
 *
 * So: UTC for all-day, school time for anything with a real clock time. The
 * warning at the top of this file was about exactly this class of mistake, in
 * the opposite direction.
 */
const dayKeyUtcFmt = new Intl.DateTimeFormat('en-CA', { timeZone: 'UTC', ...dayKeyParts });
const dayKey = (date: Date, allDay = false) =>
  (allDay ? dayKeyUtcFmt : dayKeyFmt).format(date);

const timeFmt = new Intl.DateTimeFormat('en-US', {
  timeZone: TZ,
  hour: 'numeric',
  minute: '2-digit',
});

/** "Friday, September 11, 2026" - for the details dialog, not the squares. */
const longDateParts = {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
} as const;
const longDateFmt = new Intl.DateTimeFormat('en-US', { timeZone: TZ, ...longDateParts });
/** Same UTC-vs-school-time split as dayKey; see the note there. */
const longDateUtcFmt = new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', ...longDateParts });
const longDate = (date: Date, allDay = false) =>
  (allDay ? longDateUtcFmt : longDateFmt).format(date);

/**
 * Pill color is (kind, position within that kind on that day).
 *
 * Two different questions are being answered at once. WHAT KIND of thing is
 * this - a holiday that runs all day, or something with a time you have to be
 * somewhere for - is carried by the palette: warm neutrals for all-day, cool
 * tints for timed. HOW MANY are on this square is carried by the step within
 * that palette, so two all-day events never share a color and they can be
 * counted without being read.
 *
 * Positional rather than hashed from the title. A hash gives a recurring event
 * the same color every month, which sounds better and is not: the colors then
 * mean nothing, because two unrelated events collide exactly as readily as two
 * related ones. This way the first all-day event on any square is always the
 * same color, and that is a rule a reader can learn.
 *
 * Four steps each. The current feed peaks at three of either kind on one day,
 * so a fourth is headroom; beyond that the last one repeats, and at that
 * density the square is full anyway.
 */
const TONE_STEPS = 4;

interface Placed {
  key: string;
  id: string;
  title: string;
  time: string | null;
  allDay: boolean;
  /** Sort key, so a day's events are ordered before they are colored. */
  startMs: number;
}

/** A Placed with its square's color decided. */
type Toned = Placed & { tone: string };

/**
 * Orders one square's events and gives each a tone.
 *
 * Done per square rather than on Placed, because a multi-day event is the SAME
 * object on every day it covers - it can be the first all-day event on Monday
 * and the second on Tuesday. The color belongs to the square, not the event.
 *
 * All-day first, then timed in clock order: the order a person reads a day in,
 * and it makes position stable rather than a consequence of whatever order the
 * feed happened to list things in.
 */
function toned(events: Placed[]): Toned[] {
  const ordered = [...events].sort((a, b) => {
    if (a.allDay !== b.allDay) return a.allDay ? -1 : 1;
    return a.startMs - b.startMs || a.title.localeCompare(b.title);
  });

  let allDayStep = 0;
  let timedStep = 0;
  return ordered.map((event) => {
    const step = event.allDay ? allDayStep++ : timedStep++;
    return { ...event, tone: `${event.allDay ? 'a' : 't'}${Math.min(step, TONE_STEPS - 1)}` };
  });
}

/** Everything the details dialog shows, one entry per event rather than per day. */
interface Detail {
  title: string;
  /** "Friday, September 11, 2026", or a range for a multi-day event. */
  when: string;
  /** "3:10 PM – 4:30 PM", "3:10 PM", or "All day". */
  time: string;
  location?: string;
  description?: string;
}
const details: Record<string, Detail> = {};

/** Events keyed by the day they land on, multi-day events on every day they cover. */
const byDay = new Map<string, Placed[]>();

for (const event of events) {
  const start = new Date(event.start);
  if (Number.isNaN(start.getTime())) continue;

  // An all-day event's DTEND is exclusive: a one-day holiday ends at midnight
  // the following day. Stepping to the last inclusive day keeps it off the
  // square after it.
  const rawEnd = event.end ? new Date(event.end) : start;
  const end = new Date(
    event.allDay && rawEnd.getTime() > start.getTime() ? rawEnd.getTime() - 1 : rawEnd.getTime(),
  );

  const placed: Placed = {
    key: event.id,
    id: event.id,
    title: event.title,
    time: event.allDay ? null : timeFmt.format(start),
    allDay: Boolean(event.allDay),
    startMs: start.getTime(),
  };

  /**
   * The dialog's copy, built once per event rather than once per day it covers.
   * A week-long holiday would otherwise carry seven identical copies of its
   * description into the page.
   *
   * `end` is exclusive for an all-day event, so the inclusive last day computed
   * above is what a reader should be shown - "Sept 7-11", not "Sept 7-12".
   */
  const startDay = longDate(start, event.allDay);
  const endDay = longDate(end, event.allDay);
  details[event.id] = {
    title: event.title,
    when: startDay === endDay ? startDay : `${startDay} – ${endDay}`,
    time: event.allDay
      ? 'All day'
      : event.end && rawEnd.getTime() > start.getTime()
        ? `${timeFmt.format(start)} – ${timeFmt.format(rawEnd)}`
        : timeFmt.format(start),
    ...(event.location ? { location: event.location } : {}),
    ...(event.description ? { description: event.description } : {}),
  };

  // Walk day by day, in whichever calendar this event's dates belong to - see
  // the note on dayKey. Cap the span so one malformed event with a runaway end
  // date cannot generate an unbounded loop.
  const lastKey = dayKey(end, event.allDay);
  let cursor = new Date(start);
  for (let guard = 0; guard < 60; guard += 1) {
    const key = dayKey(cursor, event.allDay);
    const list = byDay.get(key) ?? [];
    list.push(placed);
    byDay.set(key, list);
    if (key >= lastKey) break;
    cursor = new Date(cursor.getTime() + 24 * 60 * 60 * 1000);
  }
}

/** Today, in school time, so "today" is highlighted correctly. */
const todayKey = dayKey(new Date());
const [todayYear, todayMonth] = todayKey.split('-').map(Number) as [number, number, number];

/** Every month worth showing: a little history, plus everything with events. */
const monthKeys = new Set<string>();
for (let back = monthsBack; back > 0; back -= 1) {
  const d = new Date(Date.UTC(todayYear, todayMonth - 1 - back, 1));
  monthKeys.add(`${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`);
}
monthKeys.add(`${todayYear}-${String(todayMonth).padStart(2, '0')}`);
for (const key of byDay.keys()) monthKeys.add(key.slice(0, 7));

const monthList = [...monthKeys].sort();
const currentMonth = `${todayYear}-${String(todayMonth).padStart(2, '0')}`;

const monthNameFmt = new Intl.DateTimeFormat('en-US', {
  timeZone: 'UTC',
  month: 'long',
  year: 'numeric',
});

/** Sunday-first, matching every school calendar anyone here has seen. */
const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

interface Cell {
  key: string | null;
  day: number | null;
  events: Toned[];
}

/**
 * The grid for one month: leading blanks to the first weekday, then the real
 * days, then trailing blanks to complete the final week. Weeks vary from four
 * to six depending on where the month starts and how long it is, so the row
 * count is computed rather than assumed.
 */
function buildMonth(monthKey: string): { label: string; weeks: Cell[][] } {
  const [year, month] = monthKey.split('-').map(Number) as [number, number];
  const first = new Date(Date.UTC(year, month - 1, 1));
  const daysInMonth = new Date(Date.UTC(year, month, 0)).getUTCDate();
  const leading = first.getUTCDay();

  const cells: Cell[] = [];
  for (let i = 0; i < leading; i += 1) cells.push({ key: null, day: null, events: [] });
  for (let day = 1; day <= daysInMonth; day += 1) {
    const key = `${monthKey}-${String(day).padStart(2, '0')}`;
    cells.push({ key, day, events: toned(byDay.get(key) ?? []) });
  }
  while (cells.length % 7 !== 0) cells.push({ key: null, day: null, events: [] });

  const weeks: Cell[][] = [];
  for (let i = 0; i < cells.length; i += 7) weeks.push(cells.slice(i, i + 7));

  return { label: monthNameFmt.format(first), weeks };
}

const months = monthList.map((key) => ({ key, ...buildMonth(key) }));
---

<section class="calendar" aria-label="Month calendar">
  <div class="controls">
    <button type="button" class="btn" data-cal-prev aria-label="Previous month">
      <svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16">
        <path d="M10 2 4 8l6 6" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <h2 class="month-label" data-cal-label aria-live="polite"></h2>
    <button type="button" class="btn" data-cal-next aria-label="Next month">
      <svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16">
        <path d="M6 2l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <button type="button" class="btn today-btn" data-cal-today>Today</button>
    <button type="button" class="btn print-btn" data-cal-print>Print this month</button>
  </div>

  {
    months.map((month) => (
      <table
        class="month-grid"
        data-month={month.key}
        hidden={month.key !== currentMonth}
        style={`--week-rows:${month.weeks.length}`}
      >
        <caption>
          {/*
            The masthead, but only on paper. On screen the caption is visually
            hidden (it exists for screen readers, which is why the month is not
            just a heading), and a printed month leaving the school with no
            name on it is a sheet nobody can place a week later.
          */}
          <span class="print-brand" aria-hidden="true">
            <BuzzMascot size={30} class="print-mark" />
            <span class="print-school">Blackshear Elementary</span>
          </span>
          <span class="print-month">{month.label}</span>
        </caption>
        <thead>
          <tr>
            {WEEKDAYS.map((day) => (
              <th scope="col">
                <span aria-hidden="true">{day.slice(0, 1)}</span>
                <span class="sr-only">{day}</span>
                <span class="wd-full" aria-hidden="true">{day.slice(1)}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {month.weeks.map((week) => (
            <tr>
              {week.map((cell) => (
                <td
                  class:list={['cell', { blank: cell.day === null, today: cell.key === todayKey }]}
                  data-day={cell.key ?? undefined}
                >
                  {cell.day !== null && (
                    <>
                      <span class="daynum">{cell.day}</span>
                      {cell.events.length > 0 && (
                        <ul class="events">
                          {cell.events.map((event) => (
                            <li>
                              {/*
                                A button, not a div with a click handler: this is
                                the only way the pill is reachable by keyboard and
                                announced as something you can press. The accessible
                                name repeats the date because a screen reader
                                reaching it out of table context would otherwise
                                hear only "Bake Sale, button".
                              */}
                              <button
                                type="button"
                                class="pill"
                                data-tone={event.tone}
                                data-ev={event.id}
                              >
                                {event.time && <b class="ev-time">{event.time}</b>}
                                <span class="ev-title">{event.title}</span>
                              </button>
                            </li>
                          ))}
                        </ul>
                      )}
                    </>
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    ))
  }

  <p class="empty-note" data-cal-empty hidden>Nothing on the calendar this month.</p>

  {/*
    Details for every event, once each, as data rather than as markup repeated
    into every square a multi-day event touches. set:html on a JSON script is
    safe here in a way it would not be in HTML: JSON.stringify escapes the one
    sequence that could close the tag early, and the browser never parses this
    as markup.
  */}
  <script
    type="application/json"
    data-cal-details
    set:html={JSON.stringify(details).replace(/</g, '\\u003c')}
  />

  {/*
    Native <dialog>: showModal() gives the focus trap, the inert background and
    Escape-to-close for free, all of which a div would have to reimplement
    badly. Same choice as /admin.
  */}
  {/*
    Everything on one day, opened from a "+N more" pill. Separate from the event
    dialog rather than nested inside it: opening a second modal from inside the
    first is a stack a person then has to unwind, and the two answer different
    questions - "what else is on" versus "what is this".
  */}
  <dialog class="day-dialog" data-day-dialog aria-labelledby="day-dialog-title">
    <div class="day-dialog-inner">
      <h2 id="day-dialog-title" data-day-title></h2>
      <ul class="day-list" data-day-list></ul>
      <div class="ev-actions">
        <button type="button" class="btn" data-day-close>Close</button>
      </div>
    </div>
  </dialog>

  <dialog class="ev-dialog" data-cal-dialog aria-labelledby="ev-dialog-title">
    <div class="ev-dialog-inner">
      <h2 id="ev-dialog-title" data-ev-title></h2>

      {/*
        A description list, so each value is announced with its own label rather
        than as a run of unlabelled lines. The label sits on its own line above
        the value - side by side, a long address wraps under the label and the
        two read as one paragraph, which is the exact "field titles merge into
        the text" problem this is here to avoid.

        Rows are hidden individually. An event with nothing but a date shows a
        date and stops, rather than explaining what it does not have.
      */}
      <dl class="ev-fields">
        <div class="ev-row">
          <dt>Date</dt>
          <dd data-ev-when></dd>
        </div>
        <div class="ev-row">
          <dt>Time</dt>
          <dd data-ev-time></dd>
        </div>
        <div class="ev-row" data-ev-where-row hidden>
          <dt>Location</dt>
          <dd data-ev-where></dd>
        </div>
        <div class="ev-row" data-ev-desc-row hidden>
          <dt>Details</dt>
          <dd class="ev-desc" data-ev-desc></dd>
        </div>
      </dl>

      <div class="ev-actions">
        <button type="button" class="btn" data-ev-close>Close</button>
      </div>
    </div>
  </dialog>
</section>

<script>
  const grids = [...document.querySelectorAll<HTMLTableElement>('[data-month]')];
  const label = document.querySelector<HTMLElement>('[data-cal-label]');
  const empty = document.querySelector<HTMLElement>('[data-cal-empty]');
  if (grids.length && label) {
    const keys = grids.map((g) => g.dataset.month!);
    let index = Math.max(0, grids.findIndex((g) => !g.hidden));
    const startIndex = index;

    function show(to: number) {
      index = Math.min(keys.length - 1, Math.max(0, to));
      grids.forEach((grid, i) => { grid.hidden = i !== index; });
      const active = grids[index]!;
      // .print-month, not the whole caption: the caption also carries the
      // printed masthead, and reading all of it put "Blackshear Elementary"
      // in front of the month on screen.
      label!.textContent = active.querySelector('.print-month')?.textContent ?? '';
      // Only the visible month prints, so the print stylesheet needs to know
      // which one that is without re-querying.
      grids.forEach((grid) => grid.classList.toggle('printing', grid === active));
      if (empty) empty.hidden = active.querySelectorAll('.events').length > 0;
      const atStart = index === 0;
      const atEnd = index === keys.length - 1;
      document.querySelector<HTMLButtonElement>('[data-cal-prev]')!.disabled = atStart;
      document.querySelector<HTMLButtonElement>('[data-cal-next]')!.disabled = atEnd;
      // Announced rather than called directly: the clamp lives in the block
      // below with the dialogs, and a hidden month measures zero, so only the
      // month actually on screen can be measured.
      document.dispatchEvent(new CustomEvent('pta:month-shown', { detail: active }));
    }

    document.querySelector('[data-cal-prev]')!.addEventListener('click', () => show(index - 1));
    document.querySelector('[data-cal-next]')!.addEventListener('click', () => show(index + 1));
    document.querySelector('[data-cal-today]')!.addEventListener('click', () => show(startIndex));
    document.querySelector('[data-cal-print]')!.addEventListener('click', () => window.print());

    /**
     * Print the calendar and nothing else.
     *
     * A print stylesheet can only hide what it can name, and the calendar sits
     * several layers inside the page shell - header, main, the content column,
     * the page's own prose. Naming all of that would break the first time
     * somebody rearranged the layout.
     *
     * So instead of describing what to hide, walk up from the calendar and
     * hide every SIBLING at each level. That leaves exactly one path from
     * <body> to the calendar visible, whatever the surrounding structure turns
     * into later.
     *
     * Wired to beforeprint rather than only to the button, so Cmd+P behaves
     * the same as the button. Undone on afterprint, because these classes must
     * not survive into the screen view.
     */
    const calendar = document.querySelector<HTMLElement>('.calendar');
    let hidden: Element[] = [];

    function isolateForPrint() {
      hidden = [];
      let node: HTMLElement | null = calendar;
      while (node && node !== document.body && node.parentElement) {
        for (const sibling of node.parentElement.children) {
          if (sibling !== node) {
            sibling.classList.add('print-hide');
            hidden.push(sibling);
          }
        }
        node = node.parentElement;
      }
    }

    function restoreAfterPrint() {
      for (const el of hidden) el.classList.remove('print-hide');
      hidden = [];
    }

    window.addEventListener('beforeprint', isolateForPrint);
    window.addEventListener('afterprint', restoreAfterPrint);

    show(index);
  }

  /**
   * Event details.
   *
   * One delegated listener on the document rather than one per pill: a busy
   * month renders a few hundred of them across every month in the snapshot, and
   * they are spread over thirteen tables that get shown and hidden.
   */
  {
    interface Detail {
      title: string;
      when: string;
      time: string;
      location?: string;
      description?: string;
    }

    const dialog = document.querySelector<HTMLDialogElement>('[data-cal-dialog]');
    const source = document.querySelector<HTMLScriptElement>('[data-cal-details]');

    if (dialog && source) {
      let details: Record<string, Detail> = {};
      try {
        details = JSON.parse(source.textContent ?? '{}');
      } catch {
        /* A malformed island should cost the dialog, not the whole calendar. */
      }

      const $ = <T extends HTMLElement>(sel: string) => dialog.querySelector<T>(sel)!;
      const titleEl = $('[data-ev-title]');
      const whenEl = $('[data-ev-when]');
      const timeEl = $('[data-ev-time]');
      const whereEl = $('[data-ev-where]');
      const whereRow = $('[data-ev-where-row]');
      const descEl = $('[data-ev-desc]');
      const descRow = $('[data-ev-desc-row]');

      function open(id: string) {
        const detail = details[id];
        if (!detail) return;

        titleEl.textContent = detail.title;
        whenEl.textContent = detail.when;
        timeEl.textContent = detail.time;

        whereEl.textContent = detail.location ?? '';
        whereRow.hidden = !detail.location;

        /**
         * textContent, never innerHTML. Google Calendar descriptions can and do
         * contain markup, and this is third-party text arriving through an iCal
         * feed - rendering it as HTML would make whoever can add an event to
         * that calendar able to inject script into this page.
         *
         * Paragraph splitting is done by hand for the same reason: a blank line
         * becomes a real <p>, and everything inside it stays text.
         */
        descEl.textContent = '';
        if (detail.description) {
          for (const para of detail.description.split(/\n\s*\n/)) {
            const p = document.createElement('p');
            p.textContent = para.trim();
            if (p.textContent) descEl.appendChild(p);
          }
        }
        descRow.hidden = !descEl.childElementCount;

        dialog!.showModal();
      }

      /**
       * Clamps each square to the height its CSS allows and adds a "+N more".
       *
       * Measured rather than counted. How many lines an event takes depends on
       * the column width and the length of its title, so three events can be
       * three lines or seven; only the browser knows which. Counting events
       * instead was the version that let one busy day stretch its whole week
       * taller than the others.
       *
       * Runs after a month is shown and again on resize, because the answer
       * changes with the width.
       */
      function clampSquares(grid: HTMLElement) {
        for (const cell of grid.querySelectorAll<HTMLElement>('td.cell[data-day]')) {
          const list = cell.querySelector<HTMLElement>('.events');
          if (!list) continue;

          // Start from everything visible, or the measurement compounds.
          for (const item of list.querySelectorAll<HTMLElement>('li')) item.classList.remove('clipped');
          list.querySelector('.more-row')?.remove();

          const budget = parseFloat(getComputedStyle(list).maxHeight);
          if (!Number.isFinite(budget) || list.scrollHeight <= budget) continue;

          const items = [...list.querySelectorAll<HTMLElement>('li')];

          // The "+N more" pill has to fit inside the same budget, so it goes in
          // before the hiding starts rather than after.
          const more = document.createElement('li');
          more.className = 'more-row';
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'more-pill';
          button.dataset.more = cell.dataset.day!;
          more.appendChild(button);
          list.appendChild(more);

          let hidden = 0;
          // Hide from the end until it fits. At most a handful of events per
          // square, so the repeated reflow costs nothing measurable.
          for (let i = items.length - 1; i >= 0 && list.scrollHeight > budget; i -= 1) {
            items[i]!.classList.add('clipped');
            hidden += 1;
            button.textContent = `+${hidden} more`;
          }

          // Everything hidden means the budget cannot fit even one event; a
          // count with nothing visible is worse than just showing the first.
          if (hidden === items.length) {
            items[0]!.classList.remove('clipped');
            hidden -= 1;
            if (hidden === 0) more.remove();
            else button.textContent = `+${hidden} more`;
          }
        }
      }

      const dayDialog = document.querySelector<HTMLDialogElement>('[data-day-dialog]');
      const dayTitle = dayDialog?.querySelector<HTMLElement>('[data-day-title]');
      const dayList = dayDialog?.querySelector<HTMLElement>('[data-day-list]');

      const dayLabelFmt = new Intl.DateTimeFormat('en-US', {
        timeZone: 'UTC',
        weekday: 'long',
        month: 'long',
        day: 'numeric',
        year: 'numeric',
      });

      function openDay(key: string) {
        if (!dayDialog || !dayTitle || !dayList) return;
        const cell = document.querySelector<HTMLElement>(`td.cell[data-day="${key}"]`);
        if (!cell) return;

        // The key is a plain calendar date, so it is read in UTC - the same
        // rule the grid itself uses for all-day events.
        const [y, m, d] = key.split('-').map(Number) as [number, number, number];
        dayTitle.textContent = dayLabelFmt.format(new Date(Date.UTC(y, m - 1, d)));

        dayList.textContent = '';
        for (const pill of cell.querySelectorAll<HTMLElement>('.pill[data-ev]')) {
          const item = document.createElement('li');
          // A clone keeps the tint and the markup without rebuilding either.
          const copy = pill.cloneNode(true) as HTMLElement;
          copy.removeAttribute('style');
          item.appendChild(copy);
          dayList.appendChild(item);
        }
        dayDialog.showModal();
      }

      dayDialog?.querySelector('[data-day-close]')?.addEventListener('click', () => dayDialog.close());

      let shown: HTMLElement | null = null;
      document.addEventListener('pta:month-shown', (event) => {
        shown = (event as CustomEvent<HTMLElement>).detail;
        clampSquares(shown);
      });

      // Column width decides how many lines a title takes, so the answer
      // changes with the window. Debounced because resize fires continuously.
      let resizeTimer = 0;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => { if (shown) clampSquares(shown); }, 150);
      });

      /**
       * Paper shows everything.
       *
       * A printed square is wider and taller than one on screen, so the four
       * lines that fit here are not the limit there - and a "+N more" you
       * cannot click is worse than the events themselves. The clamp is undone
       * before printing and redone after, since the screen still needs it.
       */
      window.addEventListener('beforeprint', () => {
        for (const item of document.querySelectorAll('.events li.clipped')) {
          item.classList.remove('clipped');
        }
      });
      window.addEventListener('afterprint', () => { if (shown) clampSquares(shown); });

      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;

        const more = target.closest<HTMLElement>('.more-pill[data-more]');
        if (more) {
          openDay(more.dataset.more!);
          return;
        }

        const pill = target.closest<HTMLElement>('.pill[data-ev]');
        if (pill) {
          // A pill inside the day dialog closes it first, so the two modals are
          // sequential rather than stacked.
          if (dayDialog?.open && dayDialog.contains(pill)) dayDialog.close();
          open(pill.dataset.ev!);
          return;
        }

        if (dayDialog && event.target === dayDialog) { dayDialog.close(); return; }
        // Clicking the backdrop closes this one. Unlike /admin's editor there is
        // nothing here to lose: the dialog is read-only.
        if (event.target === dialog) dialog.close();
      });

      dialog.querySelector('[data-ev-close]')?.addEventListener('click', () => dialog.close());
    }
  }
</script>

<style>
  .calendar { margin-block: var(--pta-gap); }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-block-end: var(--pta-gap);
  }

  .month-label {
    margin: 0;
    flex: 1 1 10rem;
    font-family: var(--pta-font-display);
    font-size: var(--text-title);
    font-weight: var(--pta-display-weight);
    letter-spacing: var(--pta-display-tracking);
    text-transform: var(--pta-display-transform);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 44px;
    min-width: 44px;
    padding: 0.5rem 0.9rem;
    border: var(--pta-border-width) solid var(--pta-rule);
    border-radius: var(--pta-radius);
    background: var(--pta-surface);
    color: var(--pta-ink);
    font-family: var(--pta-font-display);
    font-weight: var(--pta-display-weight);
    font-size: var(--text-fine);
    letter-spacing: var(--tracking-wide);
    text-transform: var(--pta-nav-transform);
    cursor: pointer;
  }
  .btn:disabled { opacity: 0.35; cursor: default; }
  .print-btn { margin-inline-start: auto; }

  .month-grid {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .month-grid caption { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  .month-grid th {
    padding: 0.3rem;
    border: var(--pta-border-width) solid var(--pta-rule);
    background: var(--pta-surface-alt);
    font-family: var(--pta-font-display);
    font-size: var(--text-fine);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  /* "S" alone is ambiguous between Sunday and Saturday, so the rest of the
     name appears as soon as there is room for it. */
  .wd-full { display: none; }
  @media (min-width: 34rem) { .wd-full { display: inline; } }

  .cell {
    height: 6.5rem;
    padding: 0.25rem;
    border: var(--pta-border-width) solid var(--pta-rule);
    vertical-align: top;
    overflow: hidden;
  }
  .cell.blank { background: repeating-linear-gradient(45deg, #f4f4f4 0 8px, #fafafa 8px 16px); }
  .cell.today { outline: 3px solid var(--pta-accent); outline-offset: -3px; }

  .daynum {
    display: block;
    font-family: var(--pta-font-display);
    font-size: var(--text-fine);
    font-weight: var(--pta-display-weight);
  }
  .cell.today .daynum { color: var(--pta-accent); }

  /*
    A square holds about four lines of event text before the week it is in has
    to grow taller than its neighbours, which is the thing that made the rows
    uneven again after they were fixed for print. Anything past that is hidden
    and replaced by a "+N more" pill.

    The budget is a HEIGHT, not a count of events, because a long title wraps:
    one event can be three lines and three events can be three lines. The
    clamping is done in script against this value, since only the browser knows
    how many lines a title takes at the current column width.
  */
  .events {
    --events-max: 4.15rem;
    margin: 0.15rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.2rem;
    max-height: var(--events-max);
    overflow: hidden;
  }
  .events li { min-width: 0; }

  /* Set by the clamp; not the hidden attribute, so print can put them back. */
  .events li.clipped { display: none; }

  /*
    Outlined rather than filled, so it reads as a control rather than as another
    event. It is the one pill that is not a thing happening that day.
  */
  .more-pill {
    display: block;
    width: 100%;
    padding: 0.1rem 0.3rem;
    border: 1px dashed var(--pta-rule);
    border-radius: 3px;
    background: none;
    color: var(--pta-ink-muted);
    font: inherit;
    font-size: 0.64rem;
    line-height: 1.25;
    text-align: start;
    cursor: pointer;
  }
  .more-pill:hover { color: var(--pta-ink); border-color: var(--pta-ink); }
  .more-pill:focus-visible { outline: 2px solid var(--pta-focus); outline-offset: 1px; }

  /* ── The day dialog, behind "+N more" ─────────────────────────────────── */
  .day-dialog {
    width: min(28rem, calc(100vw - 2rem));
    padding: 0;
    border: var(--pta-border-width) solid var(--pta-ink);
    border-radius: var(--pta-radius);
    background: var(--pta-surface);
    color: var(--pta-ink);
    overflow: auto;
  }
  .day-dialog::backdrop { background: rgb(0 0 0 / 0.45); }
  .day-dialog-inner { padding: 1.1rem 1.2rem; }

  .day-dialog h2 {
    margin: 0 0 0.85rem;
    font-family: var(--pta-font-display);
    font-weight: var(--pta-display-weight);
    letter-spacing: var(--pta-display-tracking);
    text-transform: var(--pta-display-transform);
    font-size: var(--text-title);
    line-height: var(--leading-flat);
  }

  .day-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.4rem; }

  /* Same tints as the squares, so a day opened from "+N more" looks like the
     day it came from rather than like a different feature. */
  .day-list .pill { font-size: 0.8rem; padding: 0.4rem 0.55rem; }

  /*
    Five tints, assigned by hashing the title (see toneFor).

    All of them are a wash rather than a color: near-white, so the near-black
    text on top clears AA everywhere by a wide margin and nothing has to be
    re-checked when a tint changes. What separates one pill from the next is
    mostly the edge, not the fill - the left border is the same hue two steps
    darker, which reads at a glance without turning the month into a paintbox.

    Deliberately not the brand lemon. That is the accent, and using it here
    would mean a pill looked like the Donate button (see TASKS.md F39).
  */
  .pill {
    --tone-bg: var(--pta-surface-alt);
    --tone-edge: #cfcfc8;
    display: block;
    width: 100%;
    margin: 0;
    padding: 0.18rem 0.3rem;
    border: 0;
    border-inline-start: 3px solid var(--tone-edge);
    border-radius: 3px;
    background: var(--tone-bg);
    color: var(--pta-ink);
    font: inherit;
    font-size: 0.68rem;
    line-height: 1.25;
    text-align: start;
    cursor: pointer;
  }

  /*
    Two palettes, four steps each. `a` is all-day, `t` is timed; the digit is
    which one it is on that square. See the note on TONE_STEPS for why the
    colour means (kind, position) rather than (which event).

    Warm neutrals for all-day, cool tints for timed - a difference in
    temperature rather than in loudness, so the two groups separate at a glance
    without either shouting. Every fill is near-white, so the near-black text
    clears AA on all eight by a wide margin and none of them has to be
    re-checked when one is adjusted. The left edge does most of the work.
  */
  .pill[data-tone='a0'] { --tone-bg: #f2efe8; --tone-edge: #c9bfa8; }
  .pill[data-tone='a1'] { --tone-bg: #efe9df; --tone-edge: #c0b096; }
  .pill[data-tone='a2'] { --tone-bg: #ece5d8; --tone-edge: #b7a488; }
  .pill[data-tone='a3'] { --tone-bg: #e8e0d1; --tone-edge: #ad987a; }

  .pill[data-tone='t0'] { --tone-bg: #e9eff7; --tone-edge: #a3bcd9; }
  .pill[data-tone='t1'] { --tone-bg: #e6f0ec; --tone-edge: #9dc2b1; }
  .pill[data-tone='t2'] { --tone-bg: #eeeaf5; --tone-edge: #b3a5c9; }
  .pill[data-tone='t3'] { --tone-bg: #e7eef0; --tone-edge: #9dbac1; }

  .pill:hover { filter: brightness(0.96); }
  .pill:focus-visible { outline: 2px solid var(--pta-focus); outline-offset: 1px; }

  .ev-time { display: block; color: var(--pta-ink-muted); font-size: 0.62rem; }
  .ev-title { display: block; overflow-wrap: anywhere; }

  /* ── Event details dialog ─────────────────────────────────────────────── */
  /*
    Sized to its contents, not to a fixed width. Most of these events are a
    title and two dates, and a 34rem box around six words is mostly empty. The
    max keeps a long description to a readable measure.

    Centring comes from the site-wide `dialog:modal` rule in global.css - see
    the note there, it is not optional and it is not this component's business.
  */
  .ev-dialog {
    width: max-content;
    min-width: min(19rem, calc(100vw - 2rem));
    max-width: min(30rem, calc(100vw - 2rem));
    padding: 0;
    border: var(--pta-border-width) solid var(--pta-ink);
    border-radius: var(--pta-radius);
    background: var(--pta-surface);
    color: var(--pta-ink);
    overflow: auto;
  }

  .ev-dialog::backdrop { background: rgb(0 0 0 / 0.45); }

  .ev-dialog-inner { padding: 1.1rem 1.2rem; }

  .ev-dialog h2 {
    margin: 0;
    font-family: var(--pta-font-display);
    font-weight: var(--pta-display-weight);
    letter-spacing: var(--pta-display-tracking);
    text-transform: var(--pta-display-transform);
    font-size: var(--text-title);
    line-height: var(--leading-flat);
  }

  .ev-fields { margin: 0.85rem 0 0; }

  .ev-row + .ev-row { margin-block-start: 0.7rem; }

  /*
    Label above value, never beside it. Side by side, a wrapping address runs
    under its own label and the pair reads as one sentence - the failure mode
    to avoid here. Small caps and muted colour do the separating, so the label
    is legible as a label without a colon or a bold run competing with the
    value underneath.
  */
  .ev-row dt {
    margin: 0;
    font-family: var(--pta-font-display);
    font-weight: var(--pta-display-weight);
    font-size: 0.66rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--pta-ink-muted);
  }

  .ev-row dd {
    margin: 0.15rem 0 0;
    max-width: var(--pta-measure);
  }

  .ev-desc :global(p) { margin: 0 0 0.6rem; }
  .ev-desc :global(p:last-child) { margin-block-end: 0; }

  .ev-actions {
    display: flex;
    justify-content: flex-end;
    margin-block-start: 1.1rem;
  }

  .empty-note { margin-block-start: var(--pta-gap); color: var(--pta-ink-muted); }

  /* Phones cannot show seven usable columns. Below that the grid still works
     but the cells are short, so the day number stays and titles clip. */
  @media (max-width: 36rem) {
    .cell { height: 4.5rem; padding: 0.15rem; }
    .pill { font-size: 0.6rem; padding: 0.12rem 0.22rem; }
  }

  /*
    PRINT: one month, landscape, on a single sheet.

    @page carries the orientation, and the cell height switches to a percentage
    so the six-week months fill the same page as the four-week ones instead of
    running onto a second sheet.
  */
  @media print {
    /* Landscape, with margins tight enough that a six-week month still fits on
       one sheet. Declared here rather than only described in a comment, which
       is what the first version of this did. */
    @page {
      size: letter landscape;
      margin: 0.4in;
    }

    /* Applied by the script to every sibling on the path from body to the
       calendar, so one sheet comes out with one month on it and nothing else.
       :global because the elements being hidden belong to other components. */
    :global(.print-hide) { display: none !important; }

    .calendar { margin: 0; }
    .controls, .empty-note { display: none !important; }

    .month-grid { display: none; }
    .month-grid.printing {
      display: table !important;
      page-break-inside: avoid;
      height: 6.2in;
    }

    /*
      Every week the same height on paper.

      A table given a total height hands the surplus out in proportion to what
      each row already needs, so busy weeks grew and quiet ones - nearly always
      the first and last, which are part-weeks - stayed squat. On screen it
      never showed: there the cells have a min-height and no total to divide.

      Dividing the height explicitly is what makes them equal, and the row count
      has to come from the markup because CSS cannot count rows - a month spans
      four to six weeks depending on the day it starts on. `height` on a row is
      a minimum, so a week with more events than fits still grows rather than
      clipping somebody's event off the page; at 6.5pt that takes about a dozen
      lines in a single cell.
    */
    .month-grid.printing tbody tr {
      height: calc(6.2in / var(--week-rows, 6));
    }
    /*
      Masthead left, month centred. `caption` is display: table-caption by
      default and will not lay out as a flex row, so it becomes a block with the
      brand taken out of flow to the left - which is also what lets the month
      centre on the PAGE rather than on the space left over beside the logo.
    */
    .month-grid.printing caption {
      position: relative;
      width: auto;
      height: auto;
      clip-path: none;
      overflow: visible;
      display: block;
      min-height: 0.42in;
      padding-block-end: 0.16in;
      text-align: center;
    }

    .print-brand {
      position: absolute;
      inset-inline-start: 0;
      inset-block-start: 0;
      display: flex;
      align-items: center;
      gap: 0.08in;
      text-align: start;
    }

    .print-brand :global(.print-mark) {
      width: 0.34in;
      height: 0.34in;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .print-school {
      font-family: var(--pta-font-display);
      font-size: 10pt;
      font-weight: var(--pta-display-weight);
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
    }

    .print-month {
      font-family: var(--pta-font-display);
      font-size: 16pt;
      font-weight: var(--pta-display-weight);
      text-transform: uppercase;
    }

    .cell { height: auto; border-color: #000; }
    .cell.blank { background: none; }
    .cell.today { outline: 2px solid #000; }
    .month-grid th { background: none; border-color: #000; font-size: 8pt; }
    .wd-full { display: inline !important; }

    /*
      Pills keep their colors on paper.

      print-color-adjust is what makes that happen: browsers drop background
      colors when printing unless a page says otherwise, which is a sensible
      default for a page of text and exactly wrong here - the fill and the left
      edge ARE the information, telling all-day apart from timed and one event
      apart from the next. Without it the printout came out as undifferentiated
      lines of grey text, which is what it looked like before this rule.

      The dialog is a screen affordance and never prints.
    */
    .pill {
      padding: 0.06in 0.05in;
      border: 0;
      border-inline-start: 2.5pt solid var(--tone-edge);
      border-radius: 1.5pt;
      background: var(--tone-bg);
      font-size: 6.5pt;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .events { gap: 0.035in; }
    .ev-time { font-size: 6pt; }
    .ev-dialog { display: none !important; }
  }
</style>
