---
/**
 * The yellow jacket mark.
 *
 * WHY THIS IS DRAWN RATHER THAN CROPPED FROM THE LOGO FILES
 *
 * We have three raster marks in assets/brand/ and one partly-vector PDF. None
 * of them work here. A single raster mascot cannot be full-colour in Schoolyard
 * Bold, one-ink black in Civic Letterpress, and a flat blue silhouette in Quiet
 * Utility — and it would sit at 40px in a header, where the cartoon's detail
 * turns to mud. So the mark is geometry driven entirely by CSS custom
 * properties: every theme restyles it by redefining four tokens, and it stays
 * sharp at any size for about 1KB.
 *
 * If the board wants literal Buzz, tracing assets/brand/buzz-mascot.jpg in a
 * vector tool is a follow-up — but note TASKS.md A11 first: every asset we have
 * is a SCHOOL mark, and whether the PTA fronts with school branding or its own
 * lockup is a board decision, not a technical one.
 *
 * Tokens (defined in global.css :root, overridden per theme):
 *   --pta-mark-body    body and head fill
 *   --pta-mark-ink     banding, eye, antennae, outline
 *   --pta-mark-wing    wing fill
 *   --pta-mark-ground  disc behind the insect; transparent in most themes
 */
interface Props {
  /** Rendered size in px. The art is drawn for legibility down to ~28px. */
  size?: number;
  /**
   * Accessible name. Omit when adjacent text already names the org — the mark
   * is then decorative and gets aria-hidden, which is the common case.
   */
  label?: string;
  class?: string;
}

const { size = 44, label, class: className } = Astro.props;
const decorative = !label;
---

<svg
  class:list={['buzz', className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={label}
>
  <defs>
    <clipPath id="buzz-abdomen">
      <ellipse cx="38" cy="38" rx="18" ry="13" transform="rotate(-10 38 38)" />
    </clipPath>
  </defs>

  <circle class="buzz-ground" cx="32" cy="32" r="31" />

  {/* Antennae first so the head overlaps their roots. */}
  <path class="buzz-line" d="M15 19 C 11 12, 9 8, 10 4" />
  <path class="buzz-line" d="M21 18 C 22 11, 25 7, 28 5" />

  {/* Wings sit behind the body. */}
  <ellipse class="buzz-wing" cx="35" cy="19" rx="15" ry="6.5" transform="rotate(-30 35 19)" />
  <ellipse class="buzz-wing" cx="42" cy="24" rx="12" ry="5.5" transform="rotate(-8 42 24)" />

  {/* Stinger, before the abdomen so the body caps it cleanly. */}
  <path class="buzz-fill" d="M53 44 L 62 47 L 52 50 Z" />

  <ellipse class="buzz-fill" cx="38" cy="38" rx="18" ry="13" transform="rotate(-10 38 38)" />
  <g clip-path="url(#buzz-abdomen)">
    <rect class="buzz-band" x="31" y="22" width="7.5" height="34" transform="rotate(-10 31 22)" />
    <rect class="buzz-band" x="44" y="20" width="7.5" height="34" transform="rotate(-10 44 20)" />
  </g>

  <circle class="buzz-fill" cx="16" cy="28" r="10" />
  <ellipse class="buzz-band" cx="13.5" cy="26" rx="3.4" ry="4.2" transform="rotate(-12 13.5 26)" />
</svg>

<style>
  .buzz {
    display: block;
    flex: none;
  }

  .buzz-ground {
    fill: var(--pta-mark-ground, transparent);
  }

  .buzz-fill {
    fill: var(--pta-mark-body);
    stroke: var(--pta-mark-ink);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .buzz-band {
    fill: var(--pta-mark-ink);
  }

  .buzz-wing {
    fill: var(--pta-mark-wing);
    stroke: var(--pta-mark-ink);
    stroke-width: 1.75;
  }

  .buzz-line {
    stroke: var(--pta-mark-ink);
    stroke-width: 2.25;
    stroke-linecap: round;
    fill: none;
  }
</style>
