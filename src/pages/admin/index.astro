    White on #b3261e is 6.5:1.
  */
  :is(.admin, .sheet) .btn.danger {
    background: #b3261e;
    border-color: #8c1d18;
    color: #fff;
  }

  :is(.admin, .sheet) .btn.danger:hover { background: #8c1d18; }

  :is(.admin, .sheet) .btn.ghost { border-color: transparent; text-decoration: underline; }

