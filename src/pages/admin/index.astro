---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BuzzMascot from '../../components/BuzzMascot.astro';
import { siteThemeId, getTheme } from '../../themes/registry';
import { gradeSlugs, GRADE_LABELS } from '../../content.config';

/**
 * The announcements editor.
 *
 * A static page that talks to /admin/api/*, because the site is prerendered and
 * there is no server to render forms on. Cloudflare Access sits in front of the
 * whole /admin path, and the Worker re-verifies the signed identity on every
 * API call.
 *
 * Built to be used twice a month by someone who did not choose to be a web
 * editor. That shapes three decisions:
 *
 * - The list is the page. Writing happens in a dialog on top of it, so there is
 *   never a question of "where am I" or "did I lose the list".
 * - The dialog cannot be dismissed by clicking away from it. That gesture is
 *   the single most common way people lose a half-written post, and there is no
 *   upside to supporting it.
 * - Photos are cropped before they are uploaded, with the crop shown. A cover
 *   photo is displayed at 3:2 everywhere, and finding that out after publishing
 *   is a bad way to find it out.
 */
const theme = getTheme(siteThemeId);
const grades = gradeSlugs.map((slug) => ({ slug, label: GRADE_LABELS[slug] }));
---

<BaseLayout
  title="Edit announcements - Blackshear PTA"
  description="Internal editor for Blackshear PTA announcements."
  themeId={theme.id}
>
  <main id="main" class="admin">
    <div class="shell">
      <header class="top">
        <a class="brand" href="/">
          <BuzzMascot size={44} class="brand-mark" />
          <span class="brand-name">Announcements</span>
        </a>
        <p class="who">Signed in as <b data-who>checking…</b></p>
      </header>

      <!--
        Shown only on localhost, filled in from the session response. A dev
        server looks exactly like the real editor, but there is no local copy of
        the content behind it - reads and saves both go to the real repository -
        so the banner names the branch rather than leaving that to be assumed.
      -->
      <p class="devbar" data-devbar hidden></p>

      <div class="rule" role="presentation"></div>

      <details class="guide">
        <summary>
          <svg class="chev" viewBox="0 0 12 12" aria-hidden="true" width="13" height="13">
            <path d="M2 4.5 6 8.5 10 4.5" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span>What is this page?</span>
          <span class="summary-hint" data-guide-hint>Show</span>
        </summary>
        <div class="guide-body">
          <p>
            This is where announcements on the PTA website are written. Anything you
            post here appears on the
            <a href="/announcements">announcements page</a>, on the homepage, and in
            the RSS feed.
          </p>
          <ul>
            <li>
              <b>Saving publishes.</b> There is no separate publish step. The live site
              catches up about a minute later, once it rebuilds.
            </li>
            <li>
              <b>Nothing is ever really lost.</b> Every save and delete is recorded in
              the website's history with your name on it, and anything can be brought
              back. Do not be afraid of this page.
            </li>
            <li>
              <b>Use <i>Draft</i> to write something now and publish it later.</b> A
              draft is invisible on the site until you untick the box.
            </li>
            <li>
              <b><i>Pin</i> keeps a post at the top</b> of the list, above newer ones.
              Use it sparingly; if everything is pinned, nothing is.
            </li>
            <li>
              <b>Photos are shrunk in your browser before uploading.</b> That is what
              keeps the site fast on a phone, and it removes the location tag your
              phone puts in the file.
            </li>
          </ul>
          <p class="guide-help">
            Something looks wrong? The most common cause is a typo in an email address
            at sign-in. Ask Jon before assuming the site is broken.
          </p>
        </div>
      </details>

      <p class="status" data-status hidden role="status"></p>

      <div class="list-head">
        <h2>Posts</h2>
        <button type="button" class="btn primary" data-new>New post</button>
      </div>

      {/*
        A table, not a list of links. Five posts read fine as a list; twenty do
        not, and a column header tells you what each thing is without having to
        infer it from position. Reverse chronological with pinned first, matching
        the site exactly, so this page is never a different order from the one
        parents see.
      */}
      <div class="table-wrap">
        <table class="posts">
          <thead>
            <tr>
              {/*
                The pin column's header IS the pin, because "Pinned" in words
                would be three times the width of the thing it labels. Same
                glyph as PostBadges.astro, so the mark a board member sets here
                is the mark parents see on the site.
              */}
              <th scope="col" class="c-pin">
                <svg viewBox="0 0 16 16" aria-hidden="true" width="13" height="13">
                  <path
                    d="M9.5 1.5 14.5 6.5 12 7 9.9 9.1a4 4 0 0 0-1 1.7l-.4 1.5-4.8-4.8 1.5-.4a4 4 0 0 0 1.7-1L9 4zM4.7 11.3 1.5 14.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
                <span class="sr-only">Pinned</span>
              </th>
              <th scope="col" class="c-post">Title</th>
              <th scope="col" class="c-photos">Photos</th>
              <th scope="col" class="c-date">Date</th>
              <th scope="col" class="c-status">Status</th>
              <th scope="col" class="c-grades">Audience</th>
              <th scope="col" class="c-actions">Actions</th>
            </tr>
          </thead>
          <tbody data-list>
            <tr><td colspan="7" class="empty">Loading…</td></tr>
          </tbody>
        </table>
      </div>

      {/*
        Instagram lives below the posts table, not above it: posting
        announcements is why anyone opens this page, and this is a thing you
        touch a few times a year.

        It edits src/content/instagram.yaml through the same commit-per-save
        path as everything else here, so there is no second kind of storage and
        no second thing to back up.
      */}
      <section class="ig-block">
        <div class="list-head">
          <h2>Instagram posts</h2>
        </div>
        <p class="ig-hint">
          The posts shown on the <a href="/gallery">photos page</a>. Open a post on
          Instagram, copy the address from the browser bar, and paste it below.
          Up to <b data-ig-max>6</b>; they appear in the order listed.
        </p>
        <div class="ig-add">
          <label class="sr-only" for="ig-url">Instagram post address</label>
          <input
            id="ig-url"
            type="url"
            data-ig-input
            placeholder="https://www.instagram.com/p/..."
            autocomplete="off"
          />
          <button type="button" class="btn" data-ig-add>Add</button>
        </div>
        <p class="status" data-ig-status hidden role="status"></p>
        <ul class="ig-list" data-ig-list>
          <li class="ig-empty">Loading…</li>
        </ul>
      </section>
    </div>
  </main>

  {/*
    A real <dialog>. showModal() gives the focus trap, the inert background and
    the accessible semantics for free, all of which would otherwise have to be
    hand-rolled and got subtly wrong.
  */}
  <dialog class="sheet" data-dialog aria-labelledby="sheet-title">
    <form method="dialog" class="sheet-form" data-form>
      <div class="sheet-head">
        <h2 id="sheet-title" data-sheet-title>New post</h2>
      </div>

      <div class="sheet-body">
        <p class="status" data-sheet-status hidden role="alert"></p>

        <div class="field">
          <label for="f-title">Title</label>
          <input id="f-title" name="title" type="text" maxlength="140" required />
        </div>

        <div class="field">
          <label for="f-date">Date</label>
          <input id="f-date" name="date" type="date" required />
          <p class="hint">Controls where the post appears in the list.  Newest posts show first.</p>
        </div>

        <div class="field">
          <label for="f-body">Main content</label>
          <textarea id="f-body" name="body" rows="8" required></textarea>
          {/*
            Formatting works by putting markers around the selected words, the
            same markers the file already stores - so what is typed by hand and
            what these buttons produce are the same thing, and nothing has to
            translate between them. A WYSIWYG box would need that translation in
            both directions, and getting it wrong corrupts the post.
          */}
          <div class="format-bar" role="group" aria-label="Formatting">
            <button type="button" class="fmt" data-fmt="bold" title="Bold (Ctrl+B)">
              <b>B</b><span class="sr-only">Bold</span>
            </button>
            <button type="button" class="fmt" data-fmt="italic" title="Italic (Ctrl+I)">
              <i>I</i><span class="sr-only">Italic</span>
            </button>
            <button type="button" class="fmt" data-fmt="list" title="Bulleted list">
              <svg viewBox="0 0 16 16" aria-hidden="true" width="14" height="14">
                <path d="M5.5 4h8M5.5 8h8M5.5 12h8" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round"></path>
                <circle cx="2.5" cy="4" r="1.1"></circle>
                <circle cx="2.5" cy="8" r="1.1"></circle>
                <circle cx="2.5" cy="12" r="1.1"></circle>
              </svg>
              <span class="sr-only">Bulleted list</span>
            </button>
            <button type="button" class="fmt" data-fmt="link" title="Link">
              <svg viewBox="0 0 16 16" aria-hidden="true" width="14" height="14">
                <path d="M6.5 9.5 9.5 6.5M7 4.5 8.5 3a3 3 0 0 1 4.5 4.5L11.5 9M9 11.5 7.5 13A3 3 0 0 1 3 8.5L4.5 7"
                  fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
              </svg>
              <span class="sr-only">Link</span>
            </button>
          </div>
          <p class="hint">
            A few short paragraphs. Leave a blank line between them. Select words
            and use the buttons above to make them bold or italic.
          </p>
        </div>

        <fieldset class="field">
          <legend>Photos</legend>
          <div
            class="dropzone"
            data-dropzone
            role="button"
            tabindex="0"
            aria-describedby="drop-hint"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" width="26" height="26">
              <path
                d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M4 16v2.5A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span class="drop-title">Drop photos here, or click to choose</span>
            <span class="drop-note" id="drop-hint">
              JPEG, PNG or WebP. You can add several at once.
            </span>
          </div>
          <input
            id="f-photo"
            class="sr-only"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            multiple
            data-file
          />

          <ul class="photos" data-photos hidden></ul>
          <p class="hint" data-photos-hint hidden>
            The cover photo is the one shown on the homepage and in lists. Every photo
            needs a description.
          </p>
        </fieldset>

        <fieldset class="field">
          <legend>Which grades is this for?</legend>
          <label class="check">
            <input type="checkbox" data-all-grades checked />
            <span>Everyone at the school</span>
          </label>
          <div class="grades" data-grades hidden>
            {
              grades.map((grade) => (
                <label class="check">
                  <input type="checkbox" name="grades" value={grade.slug} />
                  <span>{grade.label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="field">
          <label for="f-href">Link (optional)</label>
          <input id="f-href" name="href" type="url" placeholder="https://" />
          <p class="hint">A "read more" button at the bottom of the post.</p>
        </div>

        <div class="field">
          <label for="f-linkLabel">Link text (optional)</label>
          <input id="f-linkLabel" name="linkLabel" type="text" placeholder="Read more" />
          <p class="hint">
            The words on that button. Leave it blank and it says "Read more".
          </p>
        </div>

        {/*
          Pinning is deliberately not here. It lives on the ⋯ menu in the post
          list, because only one post can be pinned at a time - which makes it a
          decision about the LIST rather than about this post, and a checkbox
          here would silently unpin something else with no way to see it happen.
          The value still survives an edit; see editingPinned in the script.
        */}
        <div class="checks">
          <label class="check">
            <input type="checkbox" name="draft" />
            <span>Draft (not shown on the site)</span>
          </label>
        </div>
      </div>

      <div class="sheet-foot">
        <button type="submit" class="btn primary" data-save>Save and publish</button>
        <button type="button" class="btn" data-cancel>Cancel</button>
        <button type="button" class="btn danger" data-delete hidden>Delete</button>
        <p class="hint foot-hint">The live site updates about a minute after saving.</p>
      </div>
    </form>
  </dialog>

  {/*
    Confirmations, in the page rather than as a browser alert.

    window.confirm works and is honest, but it renders as a Chrome-branded
    system box that says "blackshearpta.org says" - which reads like the
    website is doing something to you rather than asking a question. It also
    cannot be styled, so it is the one part of the editor that looks like a
    different application.
  */}
  <dialog class="sheet ask" data-ask aria-labelledby="ask-title">
    <div class="sheet-head">
      <h2 id="ask-title" data-ask-title>Are you sure?</h2>
    </div>
    <div class="sheet-body">
      <p class="ask-body" data-ask-body></p>
    </div>
    <div class="sheet-foot">
      <button type="button" class="btn danger" data-ask-yes>Yes, do it</button>
      <button type="button" class="btn primary" data-ask-no>Cancel</button>
    </div>
  </dialog>

  {/*
    The crop step. Separate dialog rather than a panel inside the editor: it is
    a modal decision about one photo, and nesting it would put two scrolling
    regions inside each other on a phone.
  */}
  <dialog class="sheet crop" data-crop-dialog aria-labelledby="crop-title">
    <div class="sheet-head">
      <h2 id="crop-title">Check the crop</h2>
    </div>
    <div class="sheet-body">
      <p class="hint" data-crop-count></p>
      <p class="hint">
        Photos are shown as a wide rectangle across the site. Drag to move, and zoom
        if you need to. What you see here is exactly what will appear.
      </p>
      <div class="crop-stage" data-crop-stage>
        <img data-crop-img alt="" />
      </div>
      <label class="zoom">
        <span>Zoom</span>
        <input type="range" min="1" max="3" step="0.01" value="1" data-crop-zoom />
      </label>
      <div class="field">
        <label for="f-crop-alt">Describe this photo</label>
        <input id="f-crop-alt" type="text" data-crop-alt />
        <p class="hint">For anyone who cannot see it. Required.</p>
      </div>
      <p class="status" data-crop-status hidden role="alert"></p>
    </div>
    <div class="sheet-foot">
      <button type="button" class="btn primary" data-crop-confirm>Use this photo</button>
      <button type="button" class="btn" data-crop-skip>Skip this one</button>
    </div>
  </dialog>
</BaseLayout>

<script>
  import { baseScale, clampView, centerView, sourceRect, type CropView } from '../../lib/crop';

  const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel)!;

  /**
   * appendChild, not append.
   *
   * worker-configuration.d.ts declares a global `interface Element` for
   * HTMLRewriter whose append() takes string | Response | ReadableStream, and
   * TypeScript merges it with the DOM's Element. That makes .append() unusable
   * on any DOM node in this project. appendChild has no such collision, and
   * this wrapper keeps the call sites readable.
   */
  const add = (parent: Element, ...kids: Node[]) => {
    for (const kid of kids) parent.appendChild(kid);
  };

  const listEl = $<HTMLTableSectionElement>('[data-list]');
  const dialog = $<HTMLDialogElement>('[data-dialog]');
  const form = $<HTMLFormElement>('[data-form]');
  const statusEl = $<HTMLElement>('[data-status]');
  const sheetStatus = $<HTMLElement>('[data-sheet-status]');
  const sheetTitle = $<HTMLElement>('[data-sheet-title]');
  const deleteBtn = $<HTMLButtonElement>('[data-delete]');
  const saveBtn = $<HTMLButtonElement>('[data-save]');
  const photosEl = $<HTMLUListElement>('[data-photos]');
  const photosHint = $<HTMLElement>('[data-photos-hint]');
  const fileInput = $<HTMLInputElement>('[data-file]');
  const dropzone = $<HTMLElement>('[data-dropzone]');
  const allGrades = $<HTMLInputElement>('[data-all-grades]');
  const gradesWrap = $<HTMLElement>('[data-grades]');

  interface Photo { key: string; alt: string }

  /** The post being edited. null means the form is creating a new one. */
  let current: { slug: string; sha: string } | null = null;

  /**
   * The open post's pin state, carried without a control.
   *
   * The checkbox is gone from the form (pinning is a list-level action now),
   * and the payload still has to send `pinned` - the API writes whole files, so
   * an omitted field is written as false. Reading it from FormData after
   * removing the input would have unpinned the pinned post on every save,
   * silently, which is the kind of bug nobody attributes to an edit.
   */
  let editingPinned = false;
  let photos: Photo[] = [];
  let cover = '';
  /** Snapshot taken when the dialog opens, to detect unsaved changes. */
  let pristine = '';

  const say = (el: HTMLElement, message: string, tone: 'ok' | 'bad' | 'busy' = 'ok') => {
    el.textContent = message;
    el.dataset.tone = tone;
    el.hidden = false;
  };
  const clear = (el: HTMLElement) => { el.hidden = true; };

  /**
   * An in-page confirmation. Resolves true if the person confirms.
   *
   * Same shape as window.confirm from the caller's side, so the call sites
   * read the same, but it is our dialog rather than a browser alert. Escape
   * and Cancel both resolve false; there is nothing to lose by dismissing a
   * question, so unlike the editor this one does close on Escape.
   */
  const askDialog = $<HTMLDialogElement>('[data-ask]');
  function ask(title: string, body: string, confirmLabel = 'Yes, do it'): Promise<boolean> {
    $('[data-ask-title]').textContent = title;
    $('[data-ask-body]').textContent = body;
    $('[data-ask-yes]').textContent = confirmLabel;
    askDialog.showModal();
    return new Promise((resolve) => {
      const done = (answer: boolean) => {
        askDialog.close();
        yes.removeEventListener('click', onYes);
        no.removeEventListener('click', onNo);
        askDialog.removeEventListener('cancel', onCancel);
        resolve(answer);
      };
      const onYes = () => done(true);
      const onNo = () => done(false);
      const onCancel = () => done(false);
      const yes = $<HTMLButtonElement>('[data-ask-yes]');
      const no = $<HTMLButtonElement>('[data-ask-no]');
      yes.addEventListener('click', onYes);
      no.addEventListener('click', onNo);
      askDialog.addEventListener('cancel', onCancel);
    });
  }

  const EXPIRED = 'Your sign-in session expired. Reload the page and sign in again.';

  async function api(path: string, init?: RequestInit) {
    let response: Response;
    try {
      response = await fetch(`/admin/api/${path}`, init);
    } catch {
      // A cross-origin redirect to the Access login page fails CORS and lands
      // here as a bare TypeError with no useful message.
      throw new Error(EXPIRED);
    }

    /**
     * Require JSON, and treat anything else as an expired session.
     *
     * When an Access session lapses, /admin/api/* answers 302 to the login
     * page. fetch follows it, so what arrives is a 200 carrying HTML:
     * response.ok is TRUE, and a silent JSON-parse failure used to leave an
     * empty payload behind, so a save reported success having written nothing.
     */
    if (
      response.redirected ||
      !(response.headers.get('content-type') ?? '').includes('application/json')
    ) {
      throw new Error(EXPIRED);
    }

    let payload: Record<string, unknown>;
    try {
      payload = await response.json();
    } catch {
      throw new Error(`The server sent something unreadable (${response.status}).`);
    }
    if (!response.ok) {
      throw new Error(String(payload.error ?? `Something went wrong (${response.status}).`));
    }
    return payload;
  }

  // ---------------------------------------------------------------- the list

  function badge(text: string, kind: string) {
    const el = document.createElement('span');
    el.className = `tag ${kind}`;
    el.textContent = text;
    return el;
  }

  const GRADE_LABELS: Record<string, string> = {
    'pre-k-3': 'Pre-K 3', 'pre-k-4': 'Pre-K 4', kinder: 'Kinder',
    '1': '1st', '2': '2nd', '3': '3rd', '4': '4th', '5': '5th',
  };

  /**
   * The pin, identical to the one PostBadges.astro puts on the public site.
   * Copied rather than imported because this page builds its rows in script and
   * an Astro component cannot be called from there - if that path ever changes,
   * both have to change together.
   */
  const PIN_SVG =
    '<svg viewBox="0 0 16 16" aria-hidden="true" width="13" height="13">' +
    '<path d="M9.5 1.5 14.5 6.5 12 7 9.9 9.1a4 4 0 0 0-1 1.7l-.4 1.5-4.8-4.8 1.5-.4a4 4 0 0 0 1.7-1L9 4zM4.7 11.3 1.5 14.5" ' +
    'fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" ' +
    'stroke-linejoin="round"/></svg>';

  /**
   * Sets or clears the pin, keeping at most one pinned post.
   *
   * There is no "pin" endpoint - /admin writes whole files - so this reads the
   * post, flips one field and writes it back. Two posts change on a swap, which
   * is two commits; that is the cost of the file-per-post design and it is
   * cheap at this size.
   *
   * The unpin happens FIRST. If the second write fails, the site is briefly
   * left with nothing pinned rather than with two pinned posts - the state that
   * makes the pin meaningless is the worse one to fail into.
   */
  async function writePinned(slug: string, pinned: boolean) {
    const post = (await api(`posts/${encodeURIComponent(slug)}`)) as Record<string, unknown>;
    await api('posts', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ...post, pinned }),
    });
  }

  async function setPinned(slug: string, pinned: boolean) {
    clear(statusEl);
    say(statusEl, pinned ? 'Pinning…' : 'Unpinning…', 'busy');
    try {
      if (pinned) {
        for (const other of lastPosts) {
          if (other.pinned && String(other.slug) !== slug) {
            await writePinned(String(other.slug), false);
          }
        }
      }
      await writePinned(slug, pinned);
      say(
        statusEl,
        pinned
          ? 'Pinned. Any post that was pinned before is not any more.'
          : 'Unpinned. Nothing is pinned now.',
        'ok',
      );
      await refresh();
    } catch (error) {
      say(statusEl, (error as Error).message, 'bad');
      await refresh();
    }
  }

  function cell(className: string) {
    const td = document.createElement('td');
    td.className = className;
    return td;
  }

  /**
   * The posts from the last refresh. Held because a pin swap has to know which
   * post is currently pinned, and asking the API again for something already on
   * screen is a round trip for nothing.
   */
  let lastPosts: Array<Record<string, unknown>> = [];

  async function refresh() {
    try {
      const { posts } = (await api('posts')) as { posts: Array<Record<string, unknown>> };
      lastPosts = posts;
      listEl.replaceChildren();
      if (posts.length === 0) {
        const tr = document.createElement('tr');
        const td = cell('empty');
        td.colSpan = 7;
        td.textContent = 'No posts yet. Use "New post" to write the first one.';
        add(tr, td);
        add(listEl, tr);
        return;
      }

      for (const post of posts) {
        const tr = document.createElement('tr');
        const slug = String(post.slug);
        const images = Array.isArray(post.images)
          ? (post.images as Array<{ key: string; alt: string }>)
          : [];

        /**
         * Title only. The opening line of the body used to sit under it as an
         * excerpt, and a thumbnail sat in a column to its left; between them a
         * five-post list was taller than the screen and the thing you actually
         * scan for - the title - was the smallest text in the row. The count
         * below says whether a post has photos, which is the only thing the
         * thumbnail was really being asked.
         */
        const postCell = cell('c-post');
        const title = document.createElement('p');
        title.className = 'row-title';
        // textContent, never innerHTML: these strings come from the repo and
        // are rendered back into a privileged page.
        title.textContent = String(post.title);
        add(postCell, title);

        // Photos: a number, zero included, so the column reads as a column
        // rather than as a scattering of occasional text.
        const photosCell = cell('c-photos');
        photosCell.textContent = String(images.length);
        if (images.length === 0) photosCell.classList.add('is-none');

        // Date
        const dateCell = cell('c-date');
        dateCell.textContent = String(post.date || 'no date');

        // Status
        // Publication state ALWAYS shows, with grades as an extra line rather
        // than a replacement. Showing only the grades made a published post
        // look like it had no status at all.
        /**
         * Pin: its own column, marked with the glyph rather than the word.
         *
         * It was a second badge inside Status, which made that cell say two
         * unrelated things and gave the pinned row an extra line of height
         * nothing else had. Pinned is not a publication state - a post can be
         * pinned and draft at once - so it does not belong on that axis.
         */
        const pinCell = cell('c-pin');
        if (post.pinned) {
          pinCell.innerHTML = PIN_SVG;
          pinCell.classList.add('is-pinned');
          pinCell.title = 'Pinned to the top of the list';
          const label = document.createElement('span');
          label.className = 'sr-only';
          label.textContent = 'Pinned';
          add(pinCell, label);
        }

        const statusCell = cell('c-status');
        if (post.draft) add(statusCell, badge('Draft', 'draft'));
        else add(statusCell, badge('Published', 'live'));
        if (post.partial) add(statusCell, badge('Still saving', 'partial'));

        /**
         * Grades get their own column.
         *
         * They were a second line inside Status, which put two unrelated facts
         * in one cell and made the row taller for the posts that had both.
         * "Everyone" rather than a blank, because an empty cell reads as
         * "nobody set this" when the meaning is the whole school.
         */
        const gradesCell = cell('c-grades');
        const gradeList = Array.isArray(post.grades) ? post.grades : [];
        if (gradeList.length > 0) {
          gradesCell.textContent = gradeList
            .map((x) => GRADE_LABELS[String(x)] ?? String(x))
            .join(', ');
        } else {
          gradesCell.textContent = 'Everyone';
          gradesCell.classList.add('is-all');
        }

        // Actions: both are buttons. Previously these were bare text and a
        // link crammed together, and neither read as something you could press.
        const actionCell = cell('c-actions');

        const PENCIL =
          '<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16">' +
          '<path d="M11.5 1.5 14.5 4.5 5 14H2v-3z" fill="none" stroke="currentColor" ' +
          'stroke-width="1.6" stroke-linejoin="round"/></svg>';
        const EYE =
          '<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16">' +
          '<path d="M1 8s2.5-4.5 7-4.5S15 8 15 8s-2.5 4.5-7 4.5S1 8 1 8z" fill="none" ' +
          'stroke="currentColor" stroke-width="1.6"/>' +
          '<circle cx="8" cy="8" r="2" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>';

        const TRASH =
          '<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16">' +
          '<path d="M2.5 4.5h11M6 4.5V2.5h4v2M4 4.5l.7 9h6.6l.7-9" fill="none" ' +
          'stroke="currentColor" stroke-width="1.6" stroke-linecap="round" ' +
          'stroke-linejoin="round"/></svg>';

        /**
         * One menu instead of a row of icons.
         *
         * Two bare icons had no room to grow: Delete could not join them without
         * a third glyph nobody would read correctly, and the pencil and eye were
         * already being guessed at. A labelled menu says what each item does in
         * words.
         *
         * <details> carries the open state, so Enter, Space and Escape work
         * without a keydown handler - the browser already does that for a
         * summary. The panel is positioned in script rather than with CSS
         * because .table-wrap scrolls horizontally, and an absolutely positioned
         * menu inside a scroll container gets clipped by it.
         */
        const menu = document.createElement('details');
        menu.className = 'rowmenu';

        const trigger = document.createElement('summary');
        trigger.className = 'icon-btn';
        trigger.title = 'Actions for this post';
        // innerHTML only for constant SVG/entity strings that are literals in
        // this file. Post content is never set this way - see textContent above.
        trigger.innerHTML =
          '<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16">' +
          '<circle cx="8" cy="3" r="1.5"/><circle cx="8" cy="8" r="1.5"/>' +
          '<circle cx="8" cy="13" r="1.5"/></svg>' +
          `<span class="sr-only">Actions for ${'' /* title added below */}</span>`;
        trigger.querySelector('.sr-only')!.textContent = `Actions for ${String(post.title)}`;

        const panel = document.createElement('div');
        panel.className = 'rowmenu-panel';

        const editItem = document.createElement('button');
        editItem.type = 'button';
        editItem.className = 'rowmenu-item';
        editItem.innerHTML = PENCIL;
        add(editItem, document.createTextNode('Edit'));
        editItem.addEventListener('click', () => {
          menu.open = false;
          openPost(slug);
        });

        /**
         * A draft has no page on the site, so there is nothing to view. Shown
         * disabled rather than hidden, so the menu does not change shape and
         * the reason is on the item itself.
         */
        const viewItem = document.createElement(post.draft ? 'button' : 'a');
        viewItem.className = 'rowmenu-item';
        viewItem.innerHTML = EYE;
        if (post.draft) {
          (viewItem as HTMLButtonElement).type = 'button';
          (viewItem as HTMLButtonElement).disabled = true;
          viewItem.title = 'Drafts have no page on the site. Untick Draft to publish it.';
          add(viewItem, document.createTextNode('View on the site'));
        } else {
          const link = viewItem as HTMLAnchorElement;
          link.href = `/announcements/${slug.replace(/\.md$/, '')}/`;
          link.target = '_blank';
          link.rel = 'noopener';
          add(viewItem, document.createTextNode('View on the site'));
          viewItem.addEventListener('click', () => { menu.open = false; });
        }

        /**
         * Pin / Unpin, with only one pinned post allowed.
         *
         * The point of a pin is "read this first", and two of them says
         * neither. So pinning swaps: whatever was pinned gets unpinned in the
         * same action. Unpinning the pinned post leaves none, which is a
         * legitimate state - most weeks nothing needs to be first.
         */
        const pinItem = document.createElement('button');
        pinItem.type = 'button';
        pinItem.className = 'rowmenu-item';
        pinItem.innerHTML = PIN_SVG;
        add(pinItem, document.createTextNode(post.pinned ? 'Unpin' : 'Pin to top'));
        pinItem.addEventListener('click', () => {
          menu.open = false;
          void setPinned(slug, !post.pinned);
        });

        const deleteItem = document.createElement('button');
        deleteItem.type = 'button';
        deleteItem.className = 'rowmenu-item is-danger';
        deleteItem.innerHTML = TRASH;
        add(deleteItem, document.createTextNode('Delete'));
        deleteItem.addEventListener('click', () => {
          // Closed before the confirmation opens, so the menu is not left
          // hanging behind a modal it cannot be seen past.
          menu.open = false;
          void removePost(slug, String(post.title));
        });

        add(panel, editItem, viewItem, pinItem, deleteItem);
        add(menu, trigger, panel);
        add(actionCell, menu);

        add(tr, pinCell, postCell, photosCell, dateCell, statusCell, gradesCell, actionCell);
        add(listEl, tr);
      }
    } catch (error) {
      listEl.replaceChildren();
      const tr = document.createElement('tr');
      const td = cell('empty');
      td.colSpan = 7;
      td.textContent = (error as Error).message;
      add(tr, td);
      add(listEl, tr);
      say(statusEl, (error as Error).message, 'bad');
    }
  }

  // -------------------------------------------------------------- the photos

  function renderPhotos() {
    photosEl.replaceChildren();
    photosEl.hidden = photos.length === 0;
    photosHint.hidden = photos.length === 0;
    if (photos.length > 0 && !photos.some((p) => p.key === cover)) cover = photos[0]!.key;

    photos.forEach((photo, index) => {
      const li = document.createElement('li');

      const img = document.createElement('img');
      img.src = `/images/${photo.key}`;
      img.alt = '';

      const body = document.createElement('div');
      body.className = 'photo-body';

      const altLabel = document.createElement('label');
      altLabel.className = 'photo-alt';
      const altText = document.createElement('span');
      altText.className = 'field-label';
      altText.textContent = 'Description';
      const altInput = document.createElement('input');
      altInput.type = 'text';
      altInput.className = 'field-box';
      altInput.value = photo.alt;
      altInput.placeholder = 'What is in the photo?';
      altInput.addEventListener('input', () => { photos[index]!.alt = altInput.value; });
      add(altLabel, altText, altInput);

      const controls = document.createElement('div');
      controls.className = 'photo-controls';

      const coverLabel = document.createElement('label');
      coverLabel.className = 'check';
      const coverRadio = document.createElement('input');
      coverRadio.type = 'radio';
      coverRadio.name = 'cover';
      coverRadio.checked = photo.key === cover;
      coverRadio.addEventListener('change', () => { cover = photo.key; renderPhotos(); });
      const coverText = document.createElement('span');
      coverText.textContent = 'Use as cover';
      add(coverLabel, coverRadio, coverText);

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'btn danger small';
      remove.textContent = 'Remove';
      remove.addEventListener('click', () => {
        // Confirm first. The photo has already been cropped and described by
        // hand, so an accidental click costs real work, and there is no undo
        // inside the form.
        const what = photo.alt.trim() ? `"${photo.alt.trim()}"` : 'this photo';
        void ask('Remove this photo?', `${what} will be taken off this post.`, 'Remove it').then(
          (yes) => {
            if (!yes) return;
            photos.splice(index, 1);
            renderPhotos();
          },
        );
      });

      add(controls, coverLabel, remove);
      add(body, altLabel, controls);
      add(li, img, body);
      photosEl.appendChild(li);
    });
  }

  // --------------------------------------------------------------- the crop

  const cropDialog = $<HTMLDialogElement>('[data-crop-dialog]');
  const cropStage = $<HTMLElement>('[data-crop-stage]');
  const cropImg = $<HTMLImageElement>('[data-crop-img]');
  const cropZoom = $<HTMLInputElement>('[data-crop-zoom]');
  const cropAlt = $<HTMLInputElement>('[data-crop-alt]');
  const cropCount = $<HTMLElement>('[data-crop-count]');
  const cropStatus = $<HTMLElement>('[data-crop-status]');

  /** Output size for a cover. 3:2, matching how photos are displayed. */
  const OUT_W = 1600;
  const OUT_H = Math.round((OUT_W * 2) / 3);

  let queue: File[] = [];
  let bitmap: ImageBitmap | null = null;
  let view: CropView = { zoom: 1, x: 0, y: 0 };

  /** The geometry this page needs, in the shape lib/crop expects. */
  function geometry() {
    const rect = cropStage.getBoundingClientRect();
    return {
      stageW: rect.width,
      stageH: rect.height,
      imageW: bitmap?.width ?? 0,
      imageH: bitmap?.height ?? 0,
    };
  }

  function paint() {
    if (!bitmap) return;
    const geo = geometry();
    view = clampView({ ...geo, view });
    const scale = baseScale(geo) * view.zoom;
    cropImg.style.width = `${geo.imageW * scale}px`;
    cropImg.style.height = `${geo.imageH * scale}px`;
    cropImg.style.transform = `translate(${view.x}px, ${view.y}px)`;
  }

  function center() {
    if (!bitmap) return;
    view = centerView({ ...geometry(), zoom: view.zoom });
    paint();
  }

  let dragging = false;
  let last = { x: 0, y: 0 };
  cropStage.addEventListener('pointerdown', (event) => {
    dragging = true;
    last = { x: event.clientX, y: event.clientY };
    cropStage.setPointerCapture(event.pointerId);
  });
  cropStage.addEventListener('pointermove', (event) => {
    if (!dragging) return;
    view = { ...view, x: view.x + (event.clientX - last.x), y: view.y + (event.clientY - last.y) };
    last = { x: event.clientX, y: event.clientY };
    paint();
  });
  const endDrag = () => { dragging = false; };
  cropStage.addEventListener('pointerup', endDrag);
  cropStage.addEventListener('pointercancel', endDrag);
  cropZoom.addEventListener('input', () => {
    view = { ...view, zoom: Number(cropZoom.value) };
    paint();
  });

  async function showNextCrop() {
    clear(cropStatus);
    const file = queue[0];
    if (!file) {
      if (cropDialog.open) cropDialog.close();
      bitmap?.close();
      bitmap = null;
      return;
    }
    cropCount.textContent =
      queue.length === 1 ? 'One photo to check.' : `${queue.length} photos left to check.`;
    bitmap?.close();
    // imageOrientation is load-bearing: EXIF is what records that a phone was
    // held vertically, and a canvas re-encode discards it. Applying it first is
    // the difference between a portrait photo and a sideways one.
    bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });
    cropImg.src = URL.createObjectURL(file);
    cropAlt.value = '';
    cropZoom.value = '1';
    view = { zoom: 1, x: 0, y: 0 };
    if (!cropDialog.open) cropDialog.showModal();
    // Wait for layout so the stage has a measurable size.
    requestAnimationFrame(() => center());
  }

  $('[data-crop-skip]').addEventListener('click', () => {
    queue.shift();
    void showNextCrop();
  });

  $('[data-crop-confirm]').addEventListener('click', async () => {
    if (!bitmap) return;
    const alt = cropAlt.value.trim();
    if (!alt) {
      say(cropStatus, 'Please describe the photo before adding it.', 'bad');
      cropAlt.focus();
      return;
    }
    say(cropStatus, 'Uploading…', 'busy');
    try {
      // The exact region the person is looking at, in original-image pixels.
      // Shared with scripts/check-crop.mjs so the arithmetic that ships is the
      // arithmetic that is tested.
      const { sx, sy, sw, sh } = sourceRect({ ...geometry(), view });

      const canvas = document.createElement('canvas');
      canvas.width = OUT_W;
      canvas.height = OUT_H;
      const context = canvas.getContext('2d');
      if (!context) throw new Error('Could not process that image.');
      context.drawImage(bitmap, sx, sy, sw, sh, 0, 0, OUT_W, OUT_H);
      const blob = await new Promise<Blob | null>((resolve) =>
        canvas.toBlob(resolve, 'image/jpeg', 0.82),
      );
      if (!blob) throw new Error('Could not process that image.');

      const body = new FormData();
      body.append('file', new File([blob], 'photo.jpg', { type: 'image/jpeg' }));
      const result = (await api('images', { method: 'POST', body })) as { key: string };

      photos.push({ key: result.key, alt });
      if (!cover) cover = result.key;
      renderPhotos();
      queue.shift();
      await showNextCrop();
    } catch (error) {
      say(cropStatus, (error as Error).message, 'bad');
    }
  });

  function enqueue(files: FileList | File[]) {
    const accepted = [...files].filter((f) => /^image\/(jpeg|png|webp)$/.test(f.type));
    if (accepted.length === 0) {
      say(sheetStatus, 'Those files are not JPEG, PNG or WebP photos.', 'bad');
      return;
    }
    clear(sheetStatus);
    queue = accepted;
    void showNextCrop();
  }

  dropzone.addEventListener('click', () => fileInput.click());
  dropzone.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      fileInput.click();
    }
  });
  fileInput.addEventListener('change', () => {
    if (fileInput.files?.length) enqueue(fileInput.files);
    // Clear so re-picking the same file fires change again.
    fileInput.value = '';
  });
  for (const type of ['dragenter', 'dragover']) {
    dropzone.addEventListener(type, (event) => {
      event.preventDefault();
      dropzone.dataset.over = 'true';
    });
  }
  for (const type of ['dragleave', 'drop']) {
    dropzone.addEventListener(type, (event) => {
      event.preventDefault();
      delete dropzone.dataset.over;
    });
  }
  dropzone.addEventListener('drop', (event) => {
    const files = (event as DragEvent).dataTransfer?.files;
    if (files?.length) enqueue(files);
  });

  // -------------------------------------------------------------- the dialog

  function setField(name: string, value: string | boolean) {
    const el = form.elements.namedItem(name);
    if (!el) return;
    if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = Boolean(value);
    else if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) {
      el.value = String(value ?? '');
    }
  }

  function gradeBoxes() {
    return [...form.querySelectorAll<HTMLInputElement>('input[name="grades"]')];
  }

  function setGrades(values: string[]) {
    const boxes = gradeBoxes();
    for (const box of boxes) box.checked = values.includes(box.value);
    // Empty means the whole school, which is also what "all ticked" means.
    const everyone = values.length === 0;
    allGrades.checked = everyone;
    gradesWrap.hidden = everyone;
  }

  allGrades.addEventListener('change', () => {
    gradesWrap.hidden = allGrades.checked;
    if (allGrades.checked) for (const box of gradeBoxes()) box.checked = false;
  });

  /** Everything the dialog holds, as a comparable string. */
  function snapshot() {
    const data = new FormData(form);
    return JSON.stringify({
      title: data.get('title'),
      date: data.get('date'),
      body: data.get('body'),
      href: data.get('href'),
      linkLabel: data.get('linkLabel'),
      pinned: editingPinned,
      draft: data.get('draft'),
      grades: gradeBoxes().filter((b) => b.checked).map((b) => b.value),
      photos,
      cover,
    });
  }

  /**
   * Today in school time, as YYYY-MM-DD.
   *
   * en-CA gives ISO order directly. School time rather than the browser's zone,
   * so somebody posting from a trip does not get yesterday or tomorrow.
   */
  const todayInSchoolTime = () =>
    new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Chicago',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).format(new Date());

  function openEditor(post: Record<string, unknown> | null) {
    current = post ? { slug: String(post.slug), sha: String(post.sha) } : null;
    sheetTitle.textContent = post ? 'Edit post' : 'New post';
    deleteBtn.hidden = !post;
    clear(sheetStatus);

    /**
     * No future dates.
     *
     * A post dated tomorrow is not scheduled - nothing publishes it later, it
     * just sits at the top of the list looking like it already happened. Draft
     * is the tool for "not yet". `max` is what the native picker uses to grey
     * out later days and stop the arrows walking into next month, so this is
     * enforced by the control rather than argued about after the fact. The
     * server checks the date is a real date; it does not need to know today's.
     *
     * Backdating stays open, because a post written up after the event is the
     * normal case.
     */
    const today = todayInSchoolTime();
    (form.elements.namedItem('date') as HTMLInputElement).max = today;

    setField('title', String(post?.title ?? ''));
    setField('date', String(post?.date ?? today));
    setField('body', String(post?.body ?? ''));
    setField('href', String(post?.href ?? ''));
    setField('linkLabel', String(post?.linkLabel ?? ''));
    editingPinned = Boolean(post?.pinned);
    setField('draft', Boolean(post?.draft));
    setGrades(Array.isArray(post?.grades) ? (post.grades as string[]).map(String) : []);

    photos = Array.isArray(post?.images)
      ? (post.images as Photo[]).map((p) => ({ key: String(p.key), alt: String(p.alt ?? '') }))
      : [];
    cover = String(post?.cover ?? '');
    renderPhotos();

    pristine = snapshot();
    dialog.showModal();
    (form.elements.namedItem('title') as HTMLInputElement).focus();
  }

  async function tryClose() {
    if (snapshot() === pristine) { dialog.close(); return; }
    const discard = await ask(
      'Close without saving?',
      'The changes you have made to this post will be lost.',
      'Discard them',
    );
    if (discard) dialog.close();
  }

  /**
   * Clicking the backdrop does nothing, deliberately.
   *
   * It is the most common way people lose a half-written post, and there is no
   * upside: Cancel is right there. A <dialog> reports a backdrop click as a
   * click on the dialog element itself, which is what this detects.
   */
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) event.stopPropagation();
  });

  /**
   * Escape routes to the same confirmation as Cancel rather than closing
   * outright. Removing the key entirely would trap keyboard users in the
   * dialog, which trades one accessibility problem for a worse one.
   */
  dialog.addEventListener('cancel', (event) => {
    event.preventDefault();
    void tryClose();
  });

  $('[data-cancel]').addEventListener('click', () => void tryClose());

  async function openPost(slug: string) {
    clear(statusEl);
    try {
      openEditor(await api(`posts/${encodeURIComponent(slug)}`));
    } catch (error) {
      say(statusEl, (error as Error).message, 'bad');
    }
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (photos.some((photo) => !photo.alt.trim())) {
      say(sheetStatus, 'Every photo needs a description. Add the missing ones.', 'bad');
      return;
    }
    const data = new FormData(form);
    saveBtn.disabled = true;
    say(sheetStatus, 'Saving…', 'busy');
    try {
      await api('posts', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          slug: current?.slug,
          sha: current?.sha,
          title: data.get('title'),
          date: data.get('date'),
          body: data.get('body'),
          href: data.get('href'),
          linkLabel: data.get('linkLabel'),
          images: photos,
          cover,
          grades: allGrades.checked
            ? []
            : gradeBoxes().filter((b) => b.checked).map((b) => b.value),
          pinned: editingPinned,
          draft: data.get('draft') === 'on',
        }),
      });
      pristine = snapshot();
      dialog.close();
      say(statusEl, 'Saved. The live site will show it in about a minute.', 'ok');
      current = null;
      await refresh();
    } catch (error) {
      say(sheetStatus, (error as Error).message, 'bad');
    } finally {
      saveBtn.disabled = false;
    }
  });

  /**
   * Deletes a post, after confirming.
   *
   * Shared by the editor's Delete button and the row menu, so there is one
   * wording and one recovery message rather than two that drift apart. The
   * confirmation names the post: from the row menu there is nothing else on
   * screen to say which one is about to go.
   *
   * `fromSheet` decides where errors are reported. A failure while the editor
   * is open belongs inside it; a failure from the table belongs above the table.
   */
  async function removePost(slug: string, title: string, fromSheet = false) {
    const sure = await ask(
      'Delete this post?',
      `"${title}" will be taken off the site. It can be brought back from the ` +
        'website history, but not from this page.',
      'Delete it',
    );
    if (!sure) return;

    const target = fromSheet ? sheetStatus : statusEl;
    say(target, 'Deleting…', 'busy');
    try {
      await api(`posts/${encodeURIComponent(slug)}`, { method: 'DELETE' });
      if (fromSheet) {
        // Reset the dirty check before closing, or the unsaved-changes guard
        // fires on a post that no longer exists.
        pristine = snapshot();
        dialog.close();
        current = null;
      }
      say(statusEl, 'Deleted. The live site will catch up in about a minute.', 'ok');
      await refresh();
    } catch (error) {
      say(target, (error as Error).message, 'bad');
    }
  }

  deleteBtn.addEventListener('click', () => {
    if (!current) return;
    const titleField = $<HTMLInputElement>('#f-title');
    void removePost(current.slug, titleField.value.trim() || 'This post', true);
  });

  /**
   * Row menus: position on open, and only one open at a time.
   *
   * The panel is fixed-positioned from the trigger's box rather than absolutely
   * positioned inside the cell, because .table-wrap scrolls horizontally and
   * would clip it. That means the position has to be recomputed on open, and
   * the menu closed on scroll or resize rather than left floating beside where
   * its row used to be.
   *
   * Delegated on document: rows are rebuilt on every refresh, so per-row
   * listeners would have to be re-attached each time.
   */
  {
    const closeMenus = (except?: HTMLDetailsElement) => {
      for (const open of document.querySelectorAll<HTMLDetailsElement>('.rowmenu[open]')) {
        if (open !== except) open.open = false;
      }
    };

    const place = (menu: HTMLDetailsElement) => {
      const trigger = menu.querySelector<HTMLElement>('summary');
      const panel = menu.querySelector<HTMLElement>('.rowmenu-panel');
      if (!trigger || !panel) return;
      const box = trigger.getBoundingClientRect();
      // Right-aligned to the trigger, since the column sits at the table's
      // right edge and a left-aligned panel would run off screen.
      panel.style.left = `${Math.max(8, box.right - panel.offsetWidth)}px`;
      // Flip above when there is not room below, so the last row's menu is
      // not half off the bottom of the window.
      const below = window.innerHeight - box.bottom;
      panel.style.top =
        below < panel.offsetHeight + 12
          ? `${Math.max(8, box.top - panel.offsetHeight - 4)}px`
          : `${box.bottom + 4}px`;
    };

    document.addEventListener('toggle', (event) => {
      const menu = event.target as HTMLElement;
      if (!(menu instanceof HTMLDetailsElement) || !menu.classList.contains('rowmenu')) return;
      if (menu.open) {
        closeMenus(menu);
        place(menu);
      }
    }, true);

    document.addEventListener('click', (event) => {
      const inside = (event.target as HTMLElement).closest('.rowmenu');
      if (!inside) closeMenus();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenus();
    });

    // Not repositioned on scroll - closed. Following the row while the table
    // moves under it is more work and worse: the menu should not outlive the
    // moment it was opened in.
    for (const event of ['scroll', 'resize'] as const) {
      window.addEventListener(event, () => closeMenus(), { passive: true });
    }
  }

  /**
   * Formatting buttons for the body.
   *
   * They insert the same markdown the file already stores, so a post written by
   * hand and a post written with these buttons are indistinguishable, and there
   * is nothing to translate in either direction. A WYSIWYG editor would need
   * that translation both ways, and getting it wrong corrupts the post.
   *
   * setRangeText rather than replacing .value: it keeps the browser's own undo
   * history intact, so Ctrl+Z still works, and it can leave the new text
   * selected - which is what makes bolding two words and then italicising the
   * same two possible without re-selecting them.
   */
  {
    const bodyField = $<HTMLTextAreaElement>('#f-body');

    /**
     * Wraps the selection, or unwraps it if the markers are already there.
     *
     * THE SELECTION ENDS ON THE TEXT, NOT THE MARKERS. setRangeText's 'select'
     * mode selects everything it inserted, markers included - so a second press
     * looked outside those and wrapped again, turning **gloves** into
     * ****gloves****. Leaving the words selected makes the button a real toggle
     * and lets bold and italic be applied to the same words in either order.
     */
    function wrap(marker: string) {
      const { selectionStart: from, selectionEnd: to, value } = bodyField;
      const selected = value.slice(from, to);
      const width = marker.length;

      /**
       * A single '*' next to a '**' is half of a bold marker, not an italic
       * one. Without this, italicising the inside of **gloves** would strip one
       * asterisk from each side and quietly demote it to italic.
       */
      const partOfBold =
        marker === '*' &&
        (value.slice(Math.max(0, from - 2), from) === '**' || value.slice(to, to + 2) === '**');

      const wrapped =
        value.slice(Math.max(0, from - width), from) === marker &&
        value.slice(to, to + width) === marker;

      if (wrapped && !partOfBold) {
        bodyField.setRangeText(selected, from - width, to + width, 'end');
        bodyField.selectionStart = from - width;
        bodyField.selectionEnd = to - width;
      } else if (selected) {
        bodyField.setRangeText(`${marker}${selected}${marker}`, from, to, 'end');
        bodyField.selectionStart = from + width;
        bodyField.selectionEnd = to + width;
      } else {
        // Nothing selected: leave the caret between the markers, ready to type.
        bodyField.setRangeText(`${marker}${marker}`, from, to, 'end');
        bodyField.selectionStart = bodyField.selectionEnd = from + width;
      }
      bodyField.focus();
      bodyField.dispatchEvent(new Event('input', { bubbles: true }));
    }

    /** Prefixes every selected line, so a list can be made in one go. */
    function bulletList() {
      const { selectionStart: from, selectionEnd: to, value } = bodyField;
      // Grow the range to whole lines - half a line is not a list item.
      const lineStart = value.lastIndexOf('\n', from - 1) + 1;
      const lineEndIndex = value.indexOf('\n', to);
      const lineEnd = lineEndIndex === -1 ? value.length : lineEndIndex;
      const lines = value.slice(lineStart, lineEnd).split('\n');
      const allBulleted = lines.every((line) => /^\s*-\s/.test(line) || !line.trim());
      const next = lines
        .map((line) => {
          if (!line.trim()) return line;
          return allBulleted ? line.replace(/^(\s*)-\s+/, '$1') : `- ${line}`;
        })
        .join('\n');
      bodyField.setRangeText(next, lineStart, lineEnd, 'select');
      bodyField.focus();
      bodyField.dispatchEvent(new Event('input', { bubbles: true }));
    }

    /** [text](url), with the caret left in the url so it can be pasted over. */
    function link() {
      const { selectionStart: from, selectionEnd: to, value } = bodyField;
      const selected = value.slice(from, to) || 'link text';
      bodyField.setRangeText(`[${selected}](https://)`, from, to, 'end');
      const urlStart = from + selected.length + 3;
      bodyField.selectionStart = urlStart;
      bodyField.selectionEnd = urlStart + 8;
      bodyField.focus();
      bodyField.dispatchEvent(new Event('input', { bubbles: true }));
    }

    const apply = (what: string) => {
      if (what === 'bold') wrap('**');
      else if (what === 'italic') wrap('*');
      else if (what === 'list') bulletList();
      else if (what === 'link') link();
    };

    for (const button of document.querySelectorAll<HTMLElement>('.fmt[data-fmt]')) {
      button.addEventListener('click', () => apply(button.dataset.fmt!));
    }

    // The shortcuts people already have in their fingers. Without these the
    // browser would apply its own bold to a textarea, which does nothing.
    bodyField.addEventListener('keydown', (event) => {
      if (!(event.metaKey || event.ctrlKey)) return;
      const key = event.key.toLowerCase();
      if (key === 'b') { event.preventDefault(); wrap('**'); }
      else if (key === 'i') { event.preventDefault(); wrap('*'); }
    });
  }

  $('[data-new]').addEventListener('click', () => { clear(statusEl); openEditor(null); });

  /**
   * Instagram posts.
   *
   * Held in memory and written whole on every change, because the list is at
   * most six strings. Add, remove and reorder are therefore all the same
   * operation - mutate the array, save, redraw - rather than three endpoints.
   *
   * Every change saves immediately. There is no Save button on purpose: a
   * separate one invites half-finished state and someone navigating away
   * believing they were done, and undoing a wrong paste is one click of Remove.
   */
  {
    const igList = $<HTMLUListElement>('[data-ig-list]');
    const igStatus = $<HTMLElement>('[data-ig-status]');
    const igAdd = $<HTMLButtonElement>('[data-ig-add]');
    const igMax = $<HTMLElement>('[data-ig-max]');
    const igInput = $<HTMLInputElement>('[data-ig-input]');

    let urls: string[] = [];
    let sha: string | null = null;
    let max = 6;

    function drawIg() {
      igList.textContent = '';
      igAdd.disabled = urls.length >= max;
      igInput.disabled = urls.length >= max;

      if (urls.length === 0) {
        const empty = document.createElement('li');
        empty.className = 'ig-empty';
        empty.textContent = 'No posts yet. The photos page shows just the photo grid.';
        add(igList, empty);
        return;
      }

      urls.forEach((url, index) => {
        const row = document.createElement('li');
        row.className = 'ig-row';

        const position = document.createElement('span');
        position.className = 'ig-num';
        position.textContent = String(index + 1);

        // A link, so it can be checked before anyone trusts the list.
        const link = document.createElement('a');
        link.className = 'ig-url';
        link.href = url;
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = url;

        const tools = document.createElement('div');
        tools.className = 'ig-tools';

        const up = document.createElement('button');
        up.type = 'button';
        up.className = 'icon-btn';
        up.title = 'Move up';
        up.setAttribute('aria-label', `Move post ${index + 1} up`);
        up.textContent = '↑';
        up.disabled = index === 0;
        up.addEventListener('click', () => {
          [urls[index - 1], urls[index]] = [urls[index]!, urls[index - 1]!];
          void saveIg('Moved.');
        });

        const down = document.createElement('button');
        down.type = 'button';
        down.className = 'icon-btn';
        down.title = 'Move down';
        down.setAttribute('aria-label', `Move post ${index + 1} down`);
        down.textContent = '↓';
        down.disabled = index === urls.length - 1;
        down.addEventListener('click', () => {
          [urls[index + 1], urls[index]] = [urls[index]!, urls[index + 1]!];
          void saveIg('Moved.');
        });

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'icon-btn danger';
        remove.title = 'Remove';
        remove.setAttribute('aria-label', `Remove post ${index + 1}`);
        remove.textContent = '✕';
        remove.addEventListener('click', async () => {
          // Reuses the same in-page confirm the delete button uses, rather
          // than window.confirm.
          if (!(await ask('Remove this post from the photos page?', 'Remove'))) return;
          urls.splice(index, 1);
          void saveIg('Removed.');
        });

        add(tools, up); add(tools, down); add(tools, remove);
        add(row, position); add(row, link); add(row, tools);
        add(igList, row);
      });
    }

    async function saveIg(done: string) {
      clear(igStatus);
      try {
        const result = (await api('instagram', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ urls, sha }),
        })) as { urls: string[]; sha: string };
        urls = result.urls;
        sha = result.sha;
        drawIg();
        say(igStatus, `${done} The photos page updates in about a minute.`, 'ok');
      } catch (error) {
        // Reload rather than leave the screen showing a change that did not
        // happen - the most likely cause is somebody else having saved.
        say(igStatus, (error as Error).message, 'bad');
        await loadIg();
      }
    }

    async function loadIg() {
      try {
        const result = (await api('instagram')) as {
          urls: string[];
          sha: string | null;
          max: number;
        };
        urls = result.urls ?? [];
        sha = result.sha;
        max = result.max ?? 6;
        igMax.textContent = String(max);
        drawIg();
      } catch (error) {
        igList.textContent = '';
        const failed = document.createElement('li');
        failed.className = 'ig-empty';
        failed.textContent = (error as Error).message;
        add(igList, failed);
      }
    }

    async function addIg() {
      const url = igInput.value.trim();
      if (!url) return;
      urls.push(url);
      // Cleared only after the save succeeds, so a rejected address is still
      // in the box to be corrected rather than lost.
      const before = urls.length;
      await saveIg('Added.');
      if (urls.length === before) igInput.value = '';
    }

    igAdd.addEventListener('click', () => void addIg());
    igInput.addEventListener('keydown', (event) => {
      // Enter is what anyone pasting into a single box will press.
      if (event.key === 'Enter') { event.preventDefault(); void addIg(); }
    });

    void loadIg();
  }

  // The chevron rotates, but a word is unambiguous in a way an icon is not.
  const guide = $<HTMLDetailsElement>('.guide');
  const guideHint = $<HTMLElement>('[data-guide-hint]');
  const syncGuide = () => { guideHint.textContent = guide.open ? 'Hide' : 'Show'; };
  guide.addEventListener('toggle', syncGuide);
  syncGuide();

  (async () => {
    try {
      const session = (await api('session')) as {
        email: string;
        dev?: boolean;
        repo?: string;
        branch?: string;
        canWrite?: boolean;
      };
      $('[data-who]').textContent = session.email;

      // The `dev` fields only ever come back from a localhost run.
      if (session.dev) {
        const bar = $<HTMLElement>('[data-devbar]');
        bar.textContent = session.canWrite
          ? `Local development — saving commits for real to ${session.repo} on ${session.branch}.`
          : `Local development — read-only. Posts are read live from ${session.repo} on ${session.branch}.`;
        bar.classList.toggle('is-live', Boolean(session.canWrite));
        bar.hidden = false;
      }
    } catch (error) {
      $('[data-who]').textContent = 'not signed in';
      say(statusEl, (error as Error).message, 'bad');
    }
    await refresh();
  })();
</script>

