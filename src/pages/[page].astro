---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import VideoEmbed from '../components/sections/VideoEmbed.astro';
import TikTokEmbed from '../components/TikTokEmbed.astro';
import SectionGallery from '../components/SectionGallery.astro';
import Lightbox from '../components/Lightbox.astro';
import { isExternal } from '../lib/links';

/**
 * Every standalone page in src/content/pages.yaml, at its own top-level URL.
 * Adding `volunteer:` to that file publishes /volunteer with no code change,
 * which is the whole point (PROJECT-BRIEF §2: a site a non-technical volunteer
 * can still edit after board turnover).
 *
 * Astro gives explicit routes priority over dynamic ones, so a page that
 * outgrows the schema can graduate to src/pages/<name>.astro and keep its URL.
 */
export async function getStaticPaths() {
  /**
   * Pages that have graduated to their own route because they need something
   * the schema cannot express. Their text still lives in pages.yaml and still
   * edits the same way; only the rendering moved.
   *
   * Astro already gives explicit routes priority, so listing them changes no
   * behavior - it stops the build warning about the collision firing on every
   * single run, which would be permanent noise a real warning could hide in.
   *
   * Declared inside the function on purpose: Astro hoists getStaticPaths and
   * evaluates it detached from the rest of this frontmatter, so a constant
   * declared out there type-checks fine and then throws at build time.
   */
  const hasOwnRoute = new Set(['gallery', 'calendar']);

  const pages = await getCollection('pages');
  return pages
    .filter((entry) => !hasOwnRoute.has(entry.id))
    .map((entry) => ({ params: { page: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const page = entry.data;

const hasPictures = page.sections.some((s) => s.figures.length > 0 || s.photos.length > 0);

/**
 * What a folded section holds, under its heading, so someone can tell which
 * year is worth opening without opening them all.
 */
const contents = (section: (typeof page.sections)[number]) => {
  const pictures = section.figures.length + section.photos.length;
  return [
    section.videos.length === 1 && 'Video',
    section.videos.length > 1 && `${section.videos.length} videos`,
    pictures > 0 && `${pictures} ${pictures === 1 ? 'picture' : 'pictures'}`,
  ]
    .filter(Boolean)
    .join(' · ');
};
---

<PageLayout page={page}>
  {page.body.map((paragraph) => <p class="prose">{paragraph}</p>)}

  {
    page.cta && (
      <p class="cta-row">
        <a
          class="cta"
          href={page.cta.href}
          target={isExternal(page.cta.href) ? '_blank' : undefined}
          rel={isExternal(page.cta.href) ? 'noopener' : undefined}
        >
          {page.cta.label}
          {isExternal(page.cta.href) && <span class="sr-only"> (opens in a new tab)</span>}
        </a>
      </p>
    )
  }

  {
    page.sections.map((section, index) => {
      /*
        A section with `expanded` set folds shut under its heading. Native
        <details>, so it opens with no script, from the keyboard, and on its own
        when the browser's find-in-page matches something inside. Without
        `expanded` it renders exactly as every page always has.
      */
      const Wrapper = section.expanded === undefined ? 'section' : 'details';
      return (
      <Wrapper class="section-block" open={section.expanded}>
        {section.expanded === undefined ? (
          <>
            <div class="rule" role="presentation" />
            <h2>{section.heading}</h2>
          </>
        ) : (
          /* The rule goes inside the summary: anything else in a <details>
             hides when it closes, and a closed year still needs its rule. */
          <summary>
            <span class="rule" role="presentation" />
            <span class="summary-row">
              <span class="summary-text">
                <h2>{section.heading}</h2>
                {contents(section) && <span class="summary-meta">{contents(section)}</span>}
              </span>
              <span class="chevron" aria-hidden="true" />
            </span>
          </summary>
        )}
        {section.body.map((paragraph) => (
          <p class="prose">{paragraph}</p>
        ))}

        {section.videos.map((video) => (
          <div class="section-video">
            {'tiktokId' in video ? <TikTokEmbed video={video} /> : <VideoEmbed video={video} />}
          </div>
        ))}

        {section.links.length > 0 && (
          <ul class="links">
            {section.links.map((item) => (
              <li>
                <a
                  href={item.href}
                  target={isExternal(item.href) ? '_blank' : undefined}
                  rel={isExternal(item.href) ? 'noopener' : undefined}
                >
                  <span>
                    {item.label}
                    {isExternal(item.href) && <span class="sr-only"> (opens in a new tab)</span>}
                  </span>
                  {item.note && <span class="note">{item.note}</span>}
                </a>
              </li>
            ))}
          </ul>
        )}

        <SectionGallery
          figures={section.figures}
          photos={section.photos}
          group={`section-${index}`}
        />

        {/* Plain names, no destinations: sponsor tiers and thank-you lists. */}
        {section.names.length > 0 && (
          <ul class="names">
            {section.names.map((name) => (
              <li>{name}</li>
            ))}
          </ul>
        )}
      </Wrapper>
      );
    })
  }

  {
    page.contact && (
      <section class="section-block contact">
        <div class="rule" role="presentation" />
        <h2>Questions?</h2>
        <p class="prose">
          {page.contact.name && page.contact.role && (
            <>
              {page.contact.name}, {page.contact.role}.{' '}
            </>
          )}
          <a href={`mailto:${page.contact.email}`}>{page.contact.email}</a>
        </p>
        {page.contact.note && <p class="prose note-line">{page.contact.note}</p>}
      </section>
    )
  }

  {hasPictures && <Lightbox />}
</PageLayout>

<style>
  .prose {
    margin: 0 0 var(--pta-gap);
    max-width: var(--pta-measure);
  }

  .rule {
    display: block;
    height: var(--pta-rule-width);
    background: var(--pta-rule);
    margin-block-end: var(--pta-gap);
  }

  .section-block {
    padding-block-start: var(--pta-section-y);
  }

  h2 {
    margin: 0 0 var(--pta-gap);
    font-family: var(--pta-font-display);
    font-size: var(--text-title);
    font-weight: var(--pta-display-weight);
    letter-spacing: var(--pta-display-tracking);
    text-transform: var(--pta-display-transform);
  }

  /*
    A folding section's heading row. The whole row is the control, not just the
    words, so the target is the full width of the page and at least 44px tall.
  */
  summary {
    display: block;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--pta-gap);
    min-height: 44px;
    margin-block-end: var(--pta-gap);
  }

  summary h2 {
    margin: 0;
  }

  .summary-meta {
    display: block;
    margin-block-start: 0.2rem;
    font-size: var(--text-fine);
    color: var(--pta-ink-muted);
  }

  /* Drawn rather than a glyph, so it is the same in every font the themes use. */
  .chevron {
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    margin-inline-end: 0.35rem;
    border-right: 3px solid currentColor;
    border-bottom: 3px solid currentColor;
    transform: translateY(-25%) rotate(45deg);
    transition: transform 0.2s ease;
  }

  details[open] .chevron {
    transform: translateY(25%) rotate(225deg);
  }

  summary:hover h2 {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .section-video {
    margin-block-end: var(--pta-gap);
  }

  .cta-row {
    margin: 0 0 var(--pta-section-y);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.7rem 1.2rem;
    border: var(--pta-border-width) solid var(--pta-cta-border);
    border-radius: var(--pta-radius);
    background: var(--pta-cta-bg);
    color: var(--pta-cta-ink);
    box-shadow: var(--pta-shadow);
    text-decoration: none;
    font-family: var(--pta-font-display);
    font-weight: var(--pta-display-weight);
    font-size: var(--text-fine);
    letter-spacing: var(--tracking-wide);
    text-transform: var(--pta-nav-transform);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
    Bordered tiles, the same object as the homepage's Start Here block. These
    were underlined text on a hairline rule, which on the volunteer page meant
    the two steps somebody actually has to complete looked like body copy - you
    only discovered they were links by hovering.
  */
  .links {
    display: grid;
    gap: var(--pta-gap);
    max-width: var(--pta-measure);
  }

  /* The same gap below the tiles as between them, when posters or photos
     follow. Last in a section, the section's own padding does the spacing. */
  .links:not(:last-child) {
    margin-block-end: var(--pta-gap);
  }

  .links a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-height: 44px;
    padding: var(--pta-gap);
    border: var(--pta-border-width) solid var(--pta-rule);
    border-radius: var(--pta-radius);
    box-shadow: var(--pta-shadow);
    font-family: var(--pta-font-display);
    font-weight: var(--pta-display-weight);
    font-size: var(--text-body);
    color: var(--pta-ink);
    text-decoration: none;
  }

  .links a:hover,
  .links a:focus-visible {
    background: var(--pta-accent);
    color: var(--pta-ink-on-accent);
  }

  .note {
    display: block;
    font-family: var(--pta-font-body);
    font-weight: 400;
    font-size: var(--text-fine);
    color: var(--pta-ink-muted);
  }

  .links a:hover .note,
  .links a:focus-visible .note { color: inherit; }

  /* Sponsor tiers read as a list of equals, so they wrap rather than stack:
     fifteen family names in a single column is a lot of scrolling for a page
     whose job is to say thank you. */
  .names {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.4rem var(--pta-gap);
    max-width: var(--pta-container);
  }

  .names li {
    font-size: var(--text-body);
  }

  .note-line {
    font-size: var(--text-fine);
    color: var(--pta-ink-muted);
  }

  .contact {
    padding-block-end: var(--pta-section-y);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
