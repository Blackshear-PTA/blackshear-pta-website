---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/sections/SiteHeader.astro';
import Footer from '../../components/sections/Footer.astro';
import PostBadges from '../../components/PostBadges.astro';
import { formatDate, coverImage, imageUrl, excerpt } from '../../lib/announcements';
import { isExternal } from '../../lib/links';
import { siteThemeId, getTheme } from '../../themes/registry';

/**
 * One page per announcement.
 *
 * Drafts get a page too, deliberately. Nothing links to it and it stays out of
 * the listings and the feed, so it is not published in any meaningful sense -
 * but it means whoever wrote it can preview the real thing before setting it
 * live, which is the only way to catch a photo that crops badly or a paragraph
 * that reads worse than it did in the form.
 */
export async function getStaticPaths() {
  const posts = await getCollection('announcements');
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const post = entry.data;
const { Content } = await render(entry);

const [homeEntry, siteEntry] = await Promise.all([
  getEntry('home', 'home'),
  getEntry('site', 'site'),
]);
if (!homeEntry) throw new Error('Missing home entry in src/content/home.yaml.');
if (!siteEntry) throw new Error('Missing site entry in src/content/site.yaml.');

const theme = getTheme(siteThemeId);
const cover = coverImage(entry);
// The cover already appears at the top; the rest go in the gallery below.
const gallery = post.images.filter((image) => image.key !== cover?.key);

// Cover first, then the rest: the order the viewer pages through.
const ordered = cover ? [cover, ...gallery] : gallery;
---

<BaseLayout
  title={`${post.title} - Blackshear PTA`}
  description={excerpt(entry, 160)}
  themeId={theme.id}
>
  <SiteHeader site={siteEntry.data} />
  <main id="main">
    <div class="shell">
      <p class="back"><a href="/announcements">All announcements</a></p>

      <article>
        <header>
          <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
          <h1>{post.title}</h1>
          <PostBadges pinned={post.pinned} draft={post.draft} grades={post.grades} />
        </header>

        {
          cover && (
            <button class="shot cover" type="button" data-shot={cover.key}>
              <img src={imageUrl(cover.key)} alt={cover.alt} loading="eager" decoding="async" />
              <span class="sr-only">View this photo full size</span>
            </button>
          )
        }

        <div class="prose">
          <Content />
        </div>

        {
          post.href && (
            <p class="cta-row">
              <a
                class="cta"
                href={post.href}
                target={isExternal(post.href) ? '_blank' : undefined}
                rel={isExternal(post.href) ? 'noopener' : undefined}
              >
                {post.linkLabel ?? 'Read more'}
                {isExternal(post.href) && <span class="sr-only"> (opens in a new tab)</span>}
              </a>
            </p>
          )
        }

        {
          gallery.length > 0 && (
            <section class="gallery" aria-label="More photos">
              <div class="rule" role="presentation" />
              <ul>
                {gallery.map((image) => (
                  <li>
                    <button class="shot" type="button" data-shot={image.key}>
                      <img src={imageUrl(image.key)} alt={image.alt} loading="lazy" decoding="async" />
                      <span class="sr-only">View this photo full size</span>
                    </button>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </article>
    </div>
  </main>
  <div class="shell">
    <Footer footer={homeEntry.data.footer} social={siteEntry.data.social} />
  </div>

  {
    ordered.length > 0 && (
      <>
        {/*
          A <dialog>, so the focus trap, the inert background and Escape all
          come from the platform rather than being reimplemented. Unlike the
          editor, clicking the backdrop DOES close this one - there is nothing
          to lose here, and dismissing a photo by tapping beside it is what
          people expect.
        */}
        <dialog class="viewer" data-viewer aria-label="Photo viewer">
          <button class="viewer-close" type="button" data-viewer-close aria-label="Close">
            <svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
              <path d="M3 3l10 10M13 3L3 13" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" />
            </svg>
          </button>

          <button class="viewer-nav prev" type="button" data-viewer-prev aria-label="Previous photo">
            <svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
              <path d="M10 2 4 8l6 6" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <figure class="viewer-figure">
            <img data-viewer-img alt="" />
            <figcaption data-viewer-caption></figcaption>
          </figure>

          <button class="viewer-nav next" type="button" data-viewer-next aria-label="Next photo">
            <svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
              <path d="M6 2l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </dialog>

        {/* is:inline - this is data for the script below, not a module to bundle. */}
        <script is:inline type="application/json" data-photos set:html={JSON.stringify(ordered)} />
      </>
    )
  }
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-viewer]');
  const data = document.querySelector<HTMLScriptElement>('[data-photos]');
  if (dialog && data) {
    const photos: Array<{ key: string; alt: string }> = JSON.parse(data.textContent ?? '[]');
    const img = document.querySelector<HTMLImageElement>('[data-viewer-img]')!;
    const caption = document.querySelector<HTMLElement>('[data-viewer-caption]')!;
    const prev = document.querySelector<HTMLButtonElement>('[data-viewer-prev]')!;
    const next = document.querySelector<HTMLButtonElement>('[data-viewer-next]')!;
    let index = 0;

    function show(to: number) {
      // Wrap, so the arrows never dead-end on a two-photo post.
      index = (to + photos.length) % photos.length;
      const photo = photos[index]!;
      img.src = `/images/${photo.key}`;
      img.alt = photo.alt;
      caption.textContent = photo.alt;
      // One photo has nothing to page through.
      const many = photos.length > 1;
      prev.hidden = !many;
      next.hidden = !many;
    }

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-shot]')) {
      button.addEventListener('click', () => {
        const at = photos.findIndex((p) => p.key === button.dataset.shot);
        show(at === -1 ? 0 : at);
        dialog.showModal();
      });
    }

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    document.querySelector('[data-viewer-close]')!.addEventListener('click', () => dialog.close());

    // Backdrop click closes. The <dialog> reports that as a click on itself.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(index - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); show(index + 1); }
    });
  }
</script>

<style>
  .shell {
    max-width: var(--pta-container);
    margin-inline: auto;
    padding-inline: var(--pta-gutter);
  }

  .back {
    margin: var(--pta-gap) 0 0;
  }

  .back a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--pta-font-display);
    font-weight: var(--pta-display-weight);
    font-size: var(--text-fine);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--pta-ink);
  }
  .back a::before {
    content: '\2190 ';
    margin-inline-end: 0.3em;
  }

  article {
    padding-block-end: var(--pta-section-y);
  }

  time {
    font-size: var(--text-fine);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--pta-ink-muted);
  }

  h1 {
    margin: 0.35rem 0 0;
    max-width: var(--pta-measure);
    font-family: var(--pta-font-display);
    font-size: var(--text-title);
    font-weight: var(--pta-display-weight);
    letter-spacing: var(--pta-display-tracking);
    text-transform: var(--pta-display-transform);
    line-height: var(--leading-snug);
  }

  /* A button, so opening the full-size view is keyboard reachable and
     announces itself, rather than being a click handler bolted to an image. */
  .shot {
    display: block;
    padding: 0;
    border: var(--pta-border-width) solid var(--pta-rule);
    border-radius: var(--pta-radius);
    background: var(--pta-surface-alt);
    cursor: zoom-in;
    width: 100%;
  }

  /* Reserved box: the dimensions are unknown at build time because the file
     lives in R2, not in the build. Without this the article text jumps when the
     photo lands. */
  .shot img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .cover {
    max-width: var(--pta-measure);
    margin-block: var(--pta-gap);
  }

  .prose {
    max-width: var(--pta-measure);
  }

  .prose :global(p) {
    margin: 0 0 var(--pta-gap);
  }

  .prose :global(a) {
    color: var(--pta-ink);
  }

  .cta-row {
    margin: var(--pta-gap) 0 0;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.7rem 1.2rem;
    border: var(--pta-border-width) solid var(--pta-cta-border);
    border-radius: var(--pta-radius);
    background: var(--pta-cta-bg);
    color: var(--pta-cta-ink);
    box-shadow: var(--pta-shadow);
    text-decoration: none;
    font-family: var(--pta-font-display);
    font-weight: var(--pta-display-weight);
    font-size: var(--text-fine);
    letter-spacing: var(--tracking-wide);
    text-transform: var(--pta-nav-transform);
  }

  .gallery {
    margin-block-start: var(--pta-section-y);
  }

  .rule {
    height: var(--pta-rule-width);
    background: var(--pta-rule);
    margin-block-end: var(--pta-gap);
  }

  .gallery ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: var(--pta-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery .shot { width: 100%; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ------------------------------------------------------- the photo viewer */

  .viewer {
    width: min(96vw, 1400px);
    max-width: none;
    max-height: 94vh;
    padding: 0;
    margin: auto;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .viewer::backdrop { background: rgb(0 0 0 / 0.85); }

  .viewer[open] {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.5rem;
  }

  .viewer-figure {
    margin: 0;
    min-width: 0;
    text-align: center;
  }

  .viewer-figure img {
    display: block;
    max-width: 100%;
    /* Room for the caption; the photo is never cropped here, which is the
       whole point of opening it. */
    max-height: 82vh;
    width: auto;
    margin-inline: auto;
    object-fit: contain;
    background: #000;
  }

  .viewer-figure figcaption {
    margin-block-start: 0.6rem;
    color: #fff;
    font-size: var(--text-fine);
  }

  .viewer-nav,
  .viewer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 999px;
    background: rgb(0 0 0 / 0.5);
    color: #fff;
    cursor: pointer;
  }
  .viewer-nav:hover, .viewer-close:hover { background: rgb(0 0 0 / 0.8); }
  .viewer-nav[hidden] { display: none; }

  .viewer-close {
    position: absolute;
    inset-block-start: -3rem;
    inset-inline-end: 0;
  }

  @media (max-width: 40rem) {
    /* Arrows move under the photo rather than squeezing it between them. */
    .viewer[open] {
      grid-template-columns: 1fr 1fr;
      grid-template-areas: 'figure figure' 'prev next';
      justify-items: center;
    }
    .viewer-figure { grid-area: figure; }
    .viewer-nav.prev { grid-area: prev; }
    .viewer-nav.next { grid-area: next; }
    .viewer-close { inset-block-start: -2.6rem; }
  }
</style>
