---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { structures } from '../layouts/structures';
import { themes, defaultThemeId } from '../themes/registry';

/**
 * /preview - the design switcher (PROJECT-BRIEF §5.4).
 *
 * Both render into the page; one is display:none. That is what makes the
 * switch instant, and instant is the whole point - a reload between variants
 * and people bail. Browsers also skip webfont downloads for display:none
 * subtrees, so a visitor pays for the active theme's two faces, not all four.
 *
 * NARROWED 2026-08-31 from six to Civic Letterpress and East Austin Print
 * Shop. The switcher machinery is unchanged and still handles any number.
 *
 * One control at every width: two pills. The mobile <select> that used to sit
 * below 48rem is gone. It earned its place when there were six options, where
 * pills needed a horizontal scroller that hid half of them behind a gesture -
 * two pills simply fit. It also had a defect CSS cannot reach: macOS renders
 * the native popup with system metrics and ignores font-size on <option>, so
 * the open list was tiny on a narrowed desktop browser. (A real iPhone shows
 * the full-size wheel picker and was never affected.) Fewer moving parts and
 * one less thing to look wrong.
 *
 * The whole bar also collapses, because it is chrome sitting on top of the
 * thing it is asking you to judge, and at some point you want it out of the
 * way. Collapsed still shows which design you are looking at.
 *
 * THIS PAGE IS DISPOSABLE. When a winner is picked, delete it along with the
 * losing theme. Nothing else imports it.
 */

const [homeEntry, siteEntry] = await Promise.all([
  getEntry('home', 'home'),
  getEntry('site', 'site'),
]);
if (!homeEntry) throw new Error('Missing home entry in src/content/home.yaml.');
if (!siteEntry) throw new Error('Missing site entry in src/content/site.yaml.');

const home = homeEntry.data;
const site = siteEntry.data;
---

<BaseLayout
  title="Choose a design - Blackshear PTA"
  description="Two design directions for the new Blackshear PTA website. Pick the one you like best."
>
  <div class="switcher" data-collapsed="false">
    <div class="switcher-inner">
      <div class="switcher-top">
        <p class="switcher-title">
          <strong>Two designs.</strong>{' '}
          <span class="showing">Showing <b data-current-name></b></span>
        </p>
        <button
          class="collapse-btn"
          type="button"
          aria-expanded="true"
          aria-controls="switcher-body"
          data-collapse-btn
        >
          <span data-collapse-label>Hide</span>
          <svg class="chev" viewBox="0 0 12 12" aria-hidden="true" width="11" height="11">
            <path d="M2 4.5 6 8.5 10 4.5" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>

      <div class="switcher-body" id="switcher-body">
        <p class="switcher-label">
          <span>Copy is taken from the current site and the same across both options. Tap through and let Jon know which you prefer.</span>
        </p>

        <div class="switcher-scroll">
          <div class="switcher-tabs" role="group" aria-label="Choose a design">
            {
              themes.map((theme) => (
                <button
                  type="button"
                  class="tab"
                  data-theme-btn={theme.id}
                  aria-pressed={theme.id === defaultThemeId ? 'true' : 'false'}
                >
                  {theme.name}
                </button>
              ))
            }
          </div>
        </div>

        <p class="switcher-desc" data-theme-desc aria-live="polite"></p>
      </div>
    </div>
  </div>

  {
    themes.map((theme) => {
      const Structure = structures[theme.structure];
      return (
        <div
          class="panel"
          data-theme={theme.id}
          data-panel={theme.id}
          hidden={theme.id !== defaultThemeId}
        >
          <Structure home={home} site={site} mainId={`main-${theme.id}`} />
        </div>
      );
    })
  }
</BaseLayout>

<script>
  import { themes, defaultThemeId } from '../themes/registry';

  const KEY = 'pta-preview-theme';
  const COLLAPSE_KEY = 'pta-preview-collapsed';
  const ids = new Set(themes.map((t) => t.id));
  const byId = new Map(themes.map((t) => [t.id, t]));

  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-btn]');
  const desc = document.querySelector<HTMLElement>('[data-theme-desc]');
  const currentName = document.querySelector<HTMLElement>('[data-current-name]');
  const skip = document.querySelector<HTMLAnchorElement>('.pta-skip-link');
  const switcher = document.querySelector<HTMLElement>('.switcher');
  const collapseBtn = document.querySelector<HTMLButtonElement>('[data-collapse-btn]');
  const collapseLabel = document.querySelector<HTMLElement>('[data-collapse-label]');

  /** localStorage throws in some private-browsing modes; never let that break switching. */
  const store = (key: string, value: string) => {
    try {
      localStorage.setItem(key, value);
    } catch {
      /* ignore */
    }
  };
  const read = (key: string) => {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  };

  function apply(id: string, persist = true) {
    if (!ids.has(id)) return;

    for (const panel of panels) panel.hidden = panel.dataset.panel !== id;
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(button.dataset.themeBtn === id));
    }
    if (desc) desc.textContent = byId.get(id)?.description ?? '';
    if (currentName) currentName.textContent = byId.get(id)?.name ?? '';
    // Keep the skip link pointing at the landmark that is actually visible.
    if (skip) skip.href = `#main-${id}`;

    if (persist) store(KEY, id);

    // Shareable: /preview?theme=jacket opens straight to that one.
    const url = new URL(window.location.href);
    url.searchParams.set('theme', id);
    history.replaceState(null, '', url);
  }

  function setCollapsed(collapsed: boolean, persist = true) {
    if (!switcher || !collapseBtn) return;
    switcher.dataset.collapsed = String(collapsed);
    collapseBtn.setAttribute('aria-expanded', String(!collapsed));
    if (collapseLabel) collapseLabel.textContent = collapsed ? 'Show' : 'Hide';
    if (persist) store(COLLAPSE_KEY, String(collapsed));
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      apply(button.dataset.themeBtn!);
      window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
    });
  }


  collapseBtn?.addEventListener('click', () => {
    setCollapsed(switcher?.dataset.collapsed !== 'true');
  });

  // URL wins over the remembered choice, so a shared link shows what was shared.
  let initial = defaultThemeId;
  const stored = read(KEY);
  if (stored && ids.has(stored)) initial = stored;
  const fromUrl = new URLSearchParams(window.location.search).get('theme');
  if (fromUrl && ids.has(fromUrl)) initial = fromUrl;

  apply(initial, false);
  setCollapsed(read(COLLAPSE_KEY) === 'true', false);
</script>

<style>
  /* The switcher is chrome, not content. It deliberately inherits NOTHING from
     the themes - otherwise it would restyle itself per theme and stop reading
     as a fixed control. Hard-coded values here are correct. */
  .switcher {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #17181c;
    color: #ffffff;
    border-bottom: 1px solid #3a3d45;
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  .switcher-inner {
    max-width: 74rem;
    margin-inline: auto;
    padding: 0.55rem 1rem 0.7rem;
  }

  .switcher-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .switcher-title {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: #c8cbd2;
  }
  .switcher-title strong {
    color: #ffffff;
  }
  .showing b {
    color: #ffffff;
    font-weight: 600;
  }

  .collapse-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0.5rem 0.8rem;
    border: 1px solid #4a4e58;
    border-radius: 999px;
    background: transparent;
    color: #e6e8ec;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }
  .collapse-btn:hover {
    border-color: #8b909c;
  }
  .collapse-btn:focus-visible,
  .tab:focus-visible {
    outline: 3px solid #f0e430;
    outline-offset: 2px;
  }

  .chev {
    transition: transform 0.15s ease;
  }
  .switcher[data-collapsed='true'] .collapse-btn .chev {
    transform: rotate(-90deg);
  }

  .switcher[data-collapsed='true'] .switcher-body {
    display: none;
  }

  .switcher-label {
    margin: 0.5rem 0 0.55rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: #c8cbd2;
  }

  /* Kept as a scroller purely as a safety net: at very small widths or with a
     large system font the two pills can still exceed the line, and scrolling
     beats them wrapping into the page content. */
  .switcher-scroll {
    overflow-x: auto;
    scrollbar-width: thin;
    margin-inline: -1rem;
    padding-inline: 1rem;
  }

  .switcher-tabs {
    display: flex;
    gap: 0.4rem;
    width: max-content;
  }

  .tab {
    flex: none;
    padding: 0.6rem 0.9rem;
    min-height: 44px; /* thumb target */
    border: 1px solid #4a4e58;
    border-radius: 999px;
    background: transparent;
    color: #e6e8ec;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
  }

  .tab:hover {
    border-color: #8b909c;
  }

  .tab[aria-pressed='true'] {
    background: #ffffff;
    border-color: #ffffff;
    color: #17181c;
  }

  .switcher-desc {
    margin: 0.6rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: #a9adb7;
    min-height: 1.2em;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Each panel owns its own ground; without this the body background from
     :root shows through and every theme looks like it is on white. */
  .panel {
    background: var(--pta-surface);
    color: var(--pta-ink);
    font-family: var(--pta-font-body);
  }

  @media (min-width: 48rem) {
    .switcher-inner {
      padding-block: 0.7rem 0.85rem;
    }
  }
</style>
