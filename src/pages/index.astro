---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { structures } from '../layouts/structures';
import { defaultThemeId, getTheme } from '../themes/registry';

const [homeEntry, siteEntry] = await Promise.all([
  getEntry('home', 'home'),
  getEntry('site', 'site'),
]);
if (!homeEntry) throw new Error('Missing home entry. Expected a top-level `home:` key in src/content/home.yaml.');
if (!siteEntry) throw new Error('Missing site entry. Expected a top-level `site:` key in src/content/site.yaml.');

const home = homeEntry.data;
const site = siteEntry.data;
const theme = getTheme(defaultThemeId);
const Structure = structures[theme.structure];
---

<BaseLayout title={home.meta.title} description={home.meta.description} themeId={theme.id}>
  <Structure home={home} site={site} video={theme.video} />
</BaseLayout>
