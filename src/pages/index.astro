---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StackedRules from '../layouts/structures/StackedRules.astro';
import { defaultThemeId, getTheme, type StructureId } from '../themes/registry';

// Every structure in src/layouts/structures/, keyed by its registry id.
// Add a structure here and to `structureIds` in the registry at the same time.
const structures = {
  'stacked-rules': StackedRules,
} satisfies Record<StructureId, unknown>;

const entry = await getEntry('home', 'home');
if (!entry) {
  throw new Error('Missing home entry. Expected a top-level `home:` key in src/content/home.yaml.');
}

const home = entry.data;
const theme = getTheme(defaultThemeId);
const Structure = structures[theme.structure];
---

<BaseLayout title={home.meta.title} description={home.meta.description} themeId={theme.id}>
  <Structure home={home} />
</BaseLayout>
