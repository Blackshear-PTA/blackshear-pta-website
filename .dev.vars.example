# Copy to .dev.vars (gitignored) for local `wrangler dev` runs.
#
# Nothing in here is needed for `npm run dev` - that is Astro on its own and
# never runs the Worker. This file is only for the :8787 worker server.



# --------------------------------------------------------------- /admin -----
# Cloudflare Access runs at Cloudflare's edge, which means it does not exist on
# localhost. Without the line below, every /admin/api call answers
# 401 "Not signed in." and the editor cannot be tested without deploying.
#
# Setting it signs you in locally as this address. It is honoured ONLY when the
# request arrives on localhost, so it cannot open anything in production even by
# accident - see devIdentity() in src/worker/access.ts for why, and
# scripts/check-access.mjs for the tests that hold it to that.
#
# Use your own address: it is what the history records as the editor.
DEV_ADMIN_EMAIL=you@example.com

# There used to be GITHUB_TOKEN, GITHUB_BRANCH and DEV_ALLOW_WRITES settings
# here, for the Instagram list. It is in the database now, like the
# announcements (TASKS.md A52), so a local editor needs no token and nothing it
# saves leaves this machine. Delete those lines from an older .dev.vars.


# ------------------------------------------------------- photos on :8787 -----
# `wrangler dev` binds a LOCAL, empty R2 bucket, so announcement photos 404
# until something copies them in. `dev worker` does that for you before it
# starts. The manual form, if you are not using the controller:
#
#   npm run dev:images
#
# It pulls the photos the current posts reference from the live site, needs no
# credentials, and does nothing on a second run.


# ------------------------------------------------- not needed for dev -------
# The two Access secrets are only consulted when DEV_ADMIN_EMAIL is unset. Set
# them if you specifically want to exercise the real token path locally, which
# will still fail: no Access token is attached to a localhost request.
# CF_ACCESS_TEAM_DOMAIN=blackshearpta.cloudflareaccess.com
# CF_ACCESS_AUD=replace-me
